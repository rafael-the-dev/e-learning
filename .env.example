# =============================================================================
# SCHOOL MANAGEMENT SAAS - ENVIRONMENT VARIABLES
# Copy this file to .env.local and fill in all required values.
# =============================================================================

# ----------------------------------------------------------------------------
# DATABASE (SQL Server)
# Format: sqlserver://HOST:PORT;database=DB;user=USER;password=PASS;encrypt=true
# ----------------------------------------------------------------------------
DATABASE_URL="sqlserver://localhost:1433;database=school_saas_dev;user=SA;password=YourStrong@Passw0rd;encrypt=false"

# ----------------------------------------------------------------------------
# AUTH.JS (Next Auth)
# Generate AUTH_SECRET with: openssl rand -base64 32
# ----------------------------------------------------------------------------
AUTH_SECRET="your-secret-here"
AUTH_URL="http://localhost:3000"

# ----------------------------------------------------------------------------
# APP
# ----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="SchoolSaaS"

# ----------------------------------------------------------------------------
# STORAGE
# Providers: local | s3 | r2
# ----------------------------------------------------------------------------
STORAGE_PROVIDER="local"
STORAGE_LOCAL_DIR="./uploads"
STORAGE_LOCAL_URL="/uploads"

# S3 / R2 (only needed when STORAGE_PROVIDER=s3 or r2)
# STORAGE_BUCKET=""
# STORAGE_REGION=""
# STORAGE_ACCESS_KEY_ID=""
# STORAGE_SECRET_ACCESS_KEY=""
# STORAGE_ENDPOINT=""

# ----------------------------------------------------------------------------
# EMAIL
# Providers: console | resend | smtp
# ----------------------------------------------------------------------------
EMAIL_PROVIDER="console"
EMAIL_FROM="noreply@schoolsaas.com"

# Resend (only when EMAIL_PROVIDER=resend)
# RESEND_API_KEY=""

# SMTP (only when EMAIL_PROVIDER=smtp)
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""

# ----------------------------------------------------------------------------
# NOTIFICATIONS CENTER — internal jobs & secrets (Phase 3.2B)
# Generate both with: openssl rand -base64 32
# ----------------------------------------------------------------------------
# Shared secret required by every POST /api/internal/jobs/* route (x-internal-job-secret header).
INTERNAL_JOB_SECRET=""
# Symmetric key used to encrypt NotificationEmailSettings.smtpPasswordEncrypted at rest.
NOTIFICATION_SECRET_ENCRYPTION_KEY=""

# ----------------------------------------------------------------------------
# STUDENT RISK PROJECTION — recompute/reconcile tuning (M11 / F-M4 / F-H4)
# All OPTIONAL; sensible in-code defaults apply when unset. Tune only under load.
# ----------------------------------------------------------------------------
# Max concurrent per-student risk recomputes in a scheduled batch flush. Default 5, clamp [1,20].
# STUDENT_RISK_RECOMPUTE_CONCURRENCY="5"
# Coalescing window (ms) the recompute scheduler buffers requests before flushing. Default in code.
# STUDENT_RISK_RECOMPUTE_WINDOW_MS="1000"
# Page size for the resumable reconcile/backfill cursor sweep. Default 100, clamp [10,500].
# STUDENT_RISK_RECONCILE_BATCH_SIZE="100"
