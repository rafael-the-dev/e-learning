// =============================================================================
// SCHOOL MANAGEMENT SAAS - DATABASE SCHEMA
// Provider: SQL Server | ORM: Prisma
// Note: SQL Server does not support enums OR multiple cascade paths.
//       All status fields use String. All relations use NoAction except where
//       a single-path cascade is safe (Account→User, InvoiceItem→Invoice).
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
}

// =============================================================================
// ORGANIZATIONS & TENANCY
// =============================================================================

model Organization {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  email     String?
  phone     String?
  address   String?
  logoUrl   String?
  // OrganizationStatus: TRIAL | ACTIVE | SUSPENDED | CANCELLED
  status    String    @default("TRIAL")
  // SubscriptionPlan: FREE | STARTER | PROFESSIONAL | ENTERPRISE
  plan      String    @default("FREE")
  timezone  String    @default("UTC")
  locale    String    @default("en")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  branches          Branch[]
  userOrganizations UserOrganization[]
  students          Student[]
  teachers          Teacher[]
  courses           Course[]
  courseCategories  CourseCategory[]
  subjects          Subject[]
  levelSubjects     LevelSubject[]
  lessons           Lesson[]
  lessonAttachments LessonAttachment[]
  subjectLessons    SubjectLesson[]
  lessonProgress    StudentLessonProgress[]
  vehicles          Vehicle[]
  invoices          Invoice[]
  payments          Payment[]
  receipts          Receipt[]
  paymentSplits     PaymentSplit[]
  paymentAllocations PaymentAllocation[]
  studentWallets    StudentWallet[]
  walletTransactions StudentWalletTransaction[]
  creditApplications CreditApplication[]
  roles             Role[]
  auditLogs         AuditLog[]
  notifications     Notification[]
  settings          OrganizationSettings?
  schedulePeriods   SchedulePeriod[]
  scheduleSlots     ScheduleSlot[]
  classGroupSchedules ClassGroupSchedule[]
  feeDefinitions           FeeDefinition[]
  enrollmentBillingPolicies EnrollmentBillingPolicy[]
  policyFees               PolicyFee[]
  discountRules            DiscountRule[]
  taxRules                 TaxRule[]
  appliedDiscounts         AppliedDiscount[]
  appliedTaxes             AppliedTax[]
  academicYears            AcademicYear[]
  academicTerms            AcademicTerm[]
  academicHolidays         AcademicHoliday[]
  academicEvents           AcademicEvent[]

  @@map("organizations")
}

model Branch {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  code           String?
  address        String?
  phone          String?
  email          String?
  isDefault      Boolean   @default(false)
  // BranchStatus: ACTIVE | INACTIVE
  status         String    @default("ACTIVE")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  classGroups  ClassGroup[]
  students     Student[]
  teachers     Teacher[]
  vehicles     Vehicle[]
  enrollments  Enrollment[]
  invoices     Invoice[]
  payments     Payment[]
  receipts     Receipt[]

  @@map("branches")
}

model OrganizationSettings {
  id                String   @id @default(cuid())
  organizationId    String   @unique
  currencyCode      String   @default("MZN")
  currencySymbol    String   @default("MT")
  dateFormat        String   @default("DD/MM/YYYY")
  taxRate           Decimal? @db.Decimal(5, 2)
  taxName           String?
  invoicePrefix     String   @default("INV")
  receiptPrefix     String   @default("REC")
  allowLatePayments Boolean  @default(true)
  gracePeriodDays   Int      @default(7)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("organization_settings")
}

// =============================================================================
// AUTHENTICATION (Auth.js / NextAuth compatible)
// =============================================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  avatarUrl     String?
  phone         String?
  passwordHash  String?
  emailVerified DateTime?
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  accounts          Account[]
  sessions          Session[]
  userOrganizations UserOrganization[]
  userRoles         UserRole[]
  notifications     Notification[]
  auditLogs         AuditLog[]         @relation("AuditActor")

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.NVarChar(Max)
  access_token      String? @db.NVarChar(Max)
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.NVarChar(Max)
  session_state     String?

  // Cascade is safe here — single path User → Account
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  // Cascade is safe here — single path User → Session
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model UserOrganization {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  isOwner        Boolean  @default(false)
  joinedAt       DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([userId, organizationId])
  @@map("user_organizations")
}

// =============================================================================
// ROLES & PERMISSIONS (RBAC)
// =============================================================================

model Role {
  id             String   @id @default(cuid())
  organizationId String?
  name           String
  description    String?
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization    Organization?    @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([organizationId, name])
  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  module      String
  action      String
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id             String   @id @default(cuid())
  userId         String
  roleId         String
  organizationId String
  branchId       String?
  assignedAt     DateTime @default(now())
  assignedBy     String?

  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  role Role @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([userId, roleId, organizationId])
  @@map("user_roles")
}

// =============================================================================
// STUDENTS
// =============================================================================

model Student {
  id             String    @id @default(cuid())
  organizationId String
  branchId       String?
  code           String?
  firstName      String
  lastName       String
  email          String?
  phone          String?
  dateOfBirth    DateTime?
  // Gender: MALE | FEMALE | OTHER
  gender         String?
  address        String?
  photoUrl       String?
  idType         String?
  idNumber       String?
  // StudentStatus: PENDING | ACTIVE | SUSPENDED | COMPLETED | DROPPED
  status         String    @default("PENDING")
  notes          String?   @db.NVarChar(Max)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  createdBy      String?
  updatedBy      String?

  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branch           Branch?            @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  enrollments      Enrollment[]
  attendances      AttendanceRecord[]
  practicalLessons PracticalLesson[]
  invoices         Invoice[]
  payments         Payment[]
  receipts         Receipt[]
  wallets          StudentWallet[]
  lessonProgress   StudentLessonProgress[]

  @@map("students")
}

// =============================================================================
// TEACHERS
// =============================================================================

model Teacher {
  id             String    @id @default(cuid())
  organizationId String
  branchId       String?
  code           String?
  firstName      String
  lastName       String
  email          String?
  phone          String?
  dateOfBirth    DateTime?
  // Gender: MALE | FEMALE | OTHER
  gender         String?
  address        String?
  photoUrl       String?
  idType         String?
  idNumber       String?
  licenseNumber  String?
  specialization String?
  // TeacherStatus: ACTIVE | INACTIVE | ON_LEAVE
  status         String    @default("ACTIVE")
  notes          String?   @db.NVarChar(Max)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  createdBy      String?
  updatedBy      String?

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branch           Branch?           @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  teacherSubjects  TeacherSubject[]
  classGroups      ClassGroup[]
  practicalLessons PracticalLesson[]

  @@map("teachers")
}

// =============================================================================
// COURSES
// =============================================================================

model CourseCategory {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  description    String?
  // CourseCategoryStatus: ACTIVE | INACTIVE | ARCHIVED
  status         String    @default("ACTIVE")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  createdBy      String?
  updatedBy      String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  courses      Course[]

  @@unique([organizationId, name])
  @@map("course_categories")
}

model Course {
  id             String    @id @default(cuid())
  organizationId String
  categoryId     String?
  name           String
  code           String?
  description    String?   @db.NVarChar(Max)
  durationWeeks  Int?
  totalHours     Int?
  price          Decimal?  @db.Decimal(10, 2)
  isActive       Boolean   @default(true)
  // CourseStatus: DRAFT | ACTIVE | INACTIVE | ARCHIVED
  status         String    @default("DRAFT")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  createdBy      String?
  updatedBy      String?

  organization  Organization    @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  category      CourseCategory? @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  levels        CourseLevel[]
  levelSubjects LevelSubject[]
  classGroups   ClassGroup[]
  enrollments   Enrollment[]

  @@map("courses")
}

model CourseLevel {
  id            String   @id @default(cuid())
  courseId      String
  name          String
  code          String?
  description   String?
  order         Int      @default(0)
  durationWeeks Int?
  totalHours    Int?
  isActive      Boolean  @default(true)
  // CourseLevelStatus: ACTIVE | INACTIVE | ARCHIVED
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  course        Course         @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  levelSubjects LevelSubject[]
  classGroups   ClassGroup[]
  enrollments   Enrollment[]

  @@map("course_levels")
}

model Subject {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  code           String?
  description    String?   @db.NVarChar(Max)
  // SubjectStatus: ACTIVE | INACTIVE | ARCHIVED
  status         String    @default("ACTIVE")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  levelSubjects   LevelSubject[]
  teacherSubjects TeacherSubject[]
  attendances     AttendanceRecord[]
  subjectLessons  SubjectLesson[]

  @@unique([organizationId, code])
  @@map("subjects")
}

model LevelSubject {
  id                  String    @id @default(cuid())
  organizationId      String
  courseId            String
  courseLevelId       String
  subjectId           String
  order               Int       @default(0)
  workloadHours       Int?
  minimumPassingGrade Decimal?  @db.Decimal(5, 2)
  isRequired          Boolean   @default(false)
  // LevelSubjectStatus: ACTIVE | INACTIVE | ARCHIVED
  status              String    @default("ACTIVE")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  course       Course       @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  courseLevel  CourseLevel  @relation(fields: [courseLevelId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([courseLevelId, subjectId])
  @@map("level_subjects")
}

model TeacherSubject {
  id         String   @id @default(cuid())
  teacherId  String
  subjectId  String
  assignedAt DateTime @default(now())

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([teacherId, subjectId])
  @@map("teacher_subjects")
}

// =============================================================================
// CLASS GROUPS & SCHEDULES
// =============================================================================

model ClassGroup {
  id             String    @id @default(cuid())
  organizationId String
  branchId       String?
  courseId       String
  courseLevelId  String?
  teacherId      String?
  name           String
  code           String?
  capacity       Int       @default(30)
  currentCount   Int       @default(0)
  startDate      DateTime?
  endDate        DateTime?
  // ClassGroupStatus: FORMING | ACTIVE | COMPLETED | CANCELLED
  status         String    @default("FORMING")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  createdBy      String?

  branch      Branch?           @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  course      Course            @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  courseLevel CourseLevel?      @relation(fields: [courseLevelId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  teacher     Teacher?          @relation(fields: [teacherId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  classGroupSchedules ClassGroupSchedule[]
  enrollments Enrollment[]
  attendances AttendanceRecord[]

  @@map("class_groups")
}

// =============================================================================
// SCHEDULE PERIODS & SLOTS
// Reusable, org-scoped schedule definitions.
// =============================================================================

model SchedulePeriod {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  code           String
  description    String?
  // ScheduleStatus: ACTIVE | INACTIVE | ARCHIVED
  status         String    @default("ACTIVE")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  slots        ScheduleSlot[]

  @@unique([organizationId, code])
  @@map("schedule_periods")
}

model ScheduleSlot {
  id               String    @id @default(cuid())
  organizationId   String
  schedulePeriodId String
  // DayOfWeek: MONDAY | TUESDAY | WEDNESDAY | THURSDAY | FRIDAY | SATURDAY | SUNDAY
  dayOfWeek        String
  startTime        String
  endTime          String
  // ScheduleStatus: ACTIVE | INACTIVE | ARCHIVED
  status           String    @default("ACTIVE")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  schedulePeriod      SchedulePeriod       @relation(fields: [schedulePeriodId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  classGroupSchedules ClassGroupSchedule[]

  @@unique([schedulePeriodId, dayOfWeek, startTime, endTime])
  @@map("schedule_slots")
}

model ClassGroupSchedule {
  id             String    @id @default(cuid())
  organizationId String
  classGroupId   String
  scheduleSlotId String
  // ScheduleStatus: ACTIVE | INACTIVE | ARCHIVED
  status         String    @default("ACTIVE")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  classGroup   ClassGroup   @relation(fields: [classGroupId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  scheduleSlot ScheduleSlot @relation(fields: [scheduleSlotId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([classGroupId, scheduleSlotId])
  @@map("class_group_schedules")
}

// =============================================================================
// BILLING POLICIES
// =============================================================================

model FeeDefinition {
  id             String    @id @default(cuid())
  organizationId String
  code           String
  name           String
  description    String?   @db.NVarChar(Max)
  // FeeType: REGISTRATION_FEE | COURSE_FEE | MATERIAL_FEE | EXAM_FEE | CERTIFICATE_FEE | PENALTY | OTHER
  feeType        String
  defaultAmount  Decimal   @db.Decimal(10, 2)
  // FeeAppliesTo: ENROLLMENT | COURSE | LEVEL | CERTIFICATE | EXAM | MANUAL
  appliesTo      String    @default("ENROLLMENT")
  isMandatory    Boolean   @default(false)
  priority       Int       @default(7)
  // FeeDefinitionStatus: ACTIVE | INACTIVE | ARCHIVED
  status         String    @default("ACTIVE")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  createdBy      String?
  updatedBy      String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  policyFees   PolicyFee[]

  @@unique([organizationId, code])
  @@map("fee_definitions")
}

model EnrollmentBillingPolicy {
  id                              String    @id @default(cuid())
  organizationId                  String
  name                            String
  description                     String?   @db.NVarChar(Max)
  autoGenerateInvoiceOnEnrollment Boolean   @default(true)
  // InvoiceMode: MANUAL | SINGLE_INVOICE | INSTALLMENT_INVOICES
  invoiceMode                     String    @default("SINGLE_INVOICE")
  // ActivationRule: MANUAL | AFTER_INVOICE_CREATED | AFTER_REGISTRATION_FEE | AFTER_FIRST_PAYMENT | AFTER_FULL_PAYMENT
  activationRule                  String    @default("MANUAL")
  installmentsRequired            Boolean   @default(false)
  defaultNumberOfInstallments     Int?
  minimumFirstPaymentAmount       Decimal?  @db.Decimal(10, 2)
  allowWalletCreditOnEnrollment   Boolean   @default(true)
  // BillingPolicyStatus: ACTIVE | INACTIVE | ARCHIVED
  status                          String    @default("ACTIVE")
  isDefault                       Boolean   @default(false)
  createdAt                       DateTime  @default(now())
  updatedAt                       DateTime  @updatedAt
  deletedAt                       DateTime?
  createdBy                       String?
  updatedBy                       String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  policyFees   PolicyFee[]
  enrollments  Enrollment[]
  invoices     Invoice[]

  @@unique([organizationId, name])
  @@map("enrollment_billing_policies")
}

model PolicyFee {
  id              String   @id @default(cuid())
  organizationId  String
  policyId        String
  feeDefinitionId String
  // PolicyFeeAmountType: FIXED | PERCENTAGE_OF_COURSE_PRICE | COURSE_BASE_PRICE
  amountType      String   @default("FIXED")
  fixedAmount     Decimal? @db.Decimal(10, 2)
  percentage      Decimal? @db.Decimal(5, 2)
  isRequired      Boolean  @default(true)
  priority        Int      @default(7)
  // PolicyFeeStatus: ACTIVE | INACTIVE
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization  Organization            @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  policy        EnrollmentBillingPolicy @relation(fields: [policyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  feeDefinition FeeDefinition           @relation(fields: [feeDefinitionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([policyId, feeDefinitionId])
  @@map("policy_fees")
}

model DiscountRule {
  id             String    @id @default(cuid())
  organizationId String
  code           String
  name           String
  description    String?   @db.NVarChar(Max)
  // DiscountType: PERCENTAGE | FIXED_AMOUNT
  discountType   String
  value          Decimal   @db.Decimal(10, 2)
  // DiscountAppliesTo: ENROLLMENT | COURSE | ALL
  appliesTo      String    @default("ENROLLMENT")
  startDate      DateTime?
  endDate        DateTime?
  stackable      Boolean   @default(false)
  // DiscountRuleStatus: ACTIVE | INACTIVE | ARCHIVED
  status         String    @default("ACTIVE")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  createdBy      String?
  updatedBy      String?

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  appliedDiscounts AppliedDiscount[]

  @@unique([organizationId, code])
  @@map("discount_rules")
}

model TaxRule {
  id                String    @id @default(cuid())
  organizationId    String
  code              String
  name              String
  description       String?   @db.NVarChar(Max)
  rate              Decimal   @db.Decimal(5, 2)
  // TaxAppliesTo: ENROLLMENT | COURSE | ALL
  appliesTo         String    @default("ENROLLMENT")
  isIncludedInPrice Boolean   @default(false)
  // TaxRuleStatus: ACTIVE | INACTIVE | ARCHIVED
  status            String    @default("ACTIVE")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?
  createdBy         String?
  updatedBy         String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  appliedTaxes AppliedTax[]

  @@unique([organizationId, code])
  @@map("tax_rules")
}

model AppliedDiscount {
  id             String   @id @default(cuid())
  organizationId String
  invoiceId      String
  discountRuleId String
  amount         Decimal  @db.Decimal(10, 2)
  description    String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  discountRule DiscountRule @relation(fields: [discountRuleId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("applied_discounts")
}

model AppliedTax {
  id             String   @id @default(cuid())
  organizationId String
  invoiceId      String
  taxRuleId      String
  amount         Decimal  @db.Decimal(10, 2)
  rate           Decimal  @db.Decimal(5, 2)
  description    String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  taxRule      TaxRule      @relation(fields: [taxRuleId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("applied_taxes")
}

// =============================================================================
// ENROLLMENTS
// =============================================================================

model Enrollment {
  id               String    @id @default(cuid())
  organizationId   String
  branchId         String?
  studentId        String
  courseId         String
  courseLevelId    String?
  classGroupId     String?
  billingPolicyId  String?
  enrollmentNumber String?
  enrollmentDate   DateTime  @default(now())
  startDate        DateTime?
  expectedEndDate  DateTime?
  // EnrollmentStatus: DRAFT | PENDING_PAYMENT | ACTIVE | COMPLETED | SUSPENDED | CANCELLED
  status           String    @default("DRAFT")
  notes            String?   @db.NVarChar(Max)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
  createdBy        String?
  updatedBy        String?

  branch         Branch?                   @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student        Student                   @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  course         Course                    @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  courseLevel    CourseLevel?              @relation(fields: [courseLevelId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  classGroup     ClassGroup?               @relation(fields: [classGroupId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  billingPolicy  EnrollmentBillingPolicy?  @relation(fields: [billingPolicyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  invoices        Invoice[]
  payments        Payment[]
  statusHistory   EnrollmentStatusHistory[]
  lessonProgress  StudentLessonProgress[]

  @@unique([organizationId, enrollmentNumber])
  @@map("enrollments")
}

model EnrollmentStatusHistory {
  id           String    @id @default(cuid())
  enrollmentId String
  fromStatus   String?
  toStatus     String
  reason       String?
  changedBy    String?
  changedAt    DateTime  @default(now())

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("enrollment_status_history")
}

// =============================================================================
// ATTENDANCE
// =============================================================================

model AttendanceRecord {
  id             String   @id @default(cuid())
  organizationId String
  classGroupId   String
  studentId      String
  subjectId      String?
  date           DateTime
  // AttendanceStatus: PRESENT | ABSENT | LATE | EXCUSED
  status         String   @default("ABSENT")
  justification  String?
  markedBy       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  classGroup ClassGroup @relation(fields: [classGroupId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subject    Subject?   @relation(fields: [subjectId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([classGroupId, studentId, date, subjectId])
  @@map("attendance_records")
}

// =============================================================================
// VEHICLES
