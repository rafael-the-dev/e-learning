// =============================================================================
// SCHOOL MANAGEMENT SAAS - DATABASE SCHEMA
// Provider: SQL Server | ORM: Prisma
// Note: SQL Server does not support enums OR multiple cascade paths.
//       All status fields use String. All relations use NoAction except where
//       a single-path cascade is safe (Account→User, InvoiceItem→Invoice).
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
}

// =============================================================================
// ORGANIZATIONS & TENANCY
// =============================================================================

model Organization {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  email     String?
  phone     String?
  address   String?
  logoUrl   String?
  // OrganizationStatus: TRIAL | ACTIVE | SUSPENDED | CANCELLED
  status    String    @default("TRIAL")
  // SubscriptionPlan: FREE | STARTER | PROFESSIONAL | ENTERPRISE
  plan      String    @default("FREE")
  timezone  String    @default("UTC")
  locale    String    @default("en")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  branches          Branch[]
  userOrganizations UserOrganization[]
  students          Student[]
  teachers          Teacher[]
  courses           Course[]
  courseCategories  CourseCategory[]
  subjects          Subject[]
  levelSubjects     LevelSubject[]
  lessons           Lesson[]
  lessonAttachments LessonAttachment[]
  subjectLessons    SubjectLesson[]
  lessonProgress    StudentLessonProgress[]
  vehicles          Vehicle[]
  invoices          Invoice[]
  payments          Payment[]
  receipts          Receipt[]
  paymentSplits     PaymentSplit[]
  paymentAllocations PaymentAllocation[]
  studentWallets    StudentWallet[]
  walletTransactions StudentWalletTransaction[]
  creditApplications CreditApplication[]
  roles             Role[]
  auditLogs         AuditLog[]
  notifications     Notification[]
  settings          OrganizationSettings?
  schedulePeriods   SchedulePeriod[]
  scheduleSlots     ScheduleSlot[]
  classGroupSchedules ClassGroupSchedule[]
  feeDefinitions           FeeDefinition[]
  enrollmentBillingPolicies EnrollmentBillingPolicy[]
  policyFees               PolicyFee[]
  discountRules            DiscountRule[]
  taxRules                 TaxRule[]
  appliedDiscounts         AppliedDiscount[]
  appliedTaxes             AppliedTax[]
  academicYears            AcademicYear[]
  academicTerms            AcademicTerm[]
  academicHolidays         AcademicHoliday[]
  academicEvents           AcademicEvent[]
  classrooms               Classroom[]
  classroomFeatures        ClassroomFeature[]
  classroomResources       ClassroomResource[]
  classroomMaintenances    ClassroomMaintenance[]
  classroomBookings        ClassroomBooking[]
  domainEvents             DomainEvent[]
  domainEventHandlerLogs   DomainEventHandlerLog[]
  importJobs               ImportJob[]
  studentTimelineEvents    StudentTimelineEvent[]
  attendanceSessions       AttendanceSession[]
  attendanceRecords        AttendanceRecord[]
  attendanceJustifications AttendanceJustification[]
  assessmentPolicies         AssessmentPolicy[]
  assessmentComponents       AssessmentComponent[]
  assessmentPeriods          AssessmentPeriod[]
  assessments                Assessment[]
  assessmentResults          AssessmentResult[]
  assessmentPublications     AssessmentPublication[]
  studentSubjectProgress     StudentSubjectProgress[]
  assessmentRetakes          AssessmentRetake[]
  studentAssessmentResults   StudentAssessmentResult[]
  gradeChangeLogs            GradeChangeLog[]
  studentLevelProgress       StudentLevelProgress[]
  studentCourseProgress      StudentCourseProgress[]
  prerequisiteGroups         LevelSubjectPrerequisiteGroup[]
  prerequisiteItems          LevelSubjectPrerequisiteItem[]
  prerequisiteWaivers        PrerequisiteWaiver[]
  levelProgressionPolicies   LevelProgressionPolicy[]
  levelProgressionRequests   LevelProgressionRequest[]
  refunds                    Refund[]
  financialTransactions      FinancialTransaction[]
  financialIntegrityIssues   FinancialIntegrityIssue[]
  financialAuditLogs         FinancialAuditLog[]
  studentDocuments           StudentDocument[]

  @@map("organizations")
}

model Branch {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  code           String?
  address        String?
  phone          String?
  email          String?
  isDefault      Boolean   @default(false)
  // BranchStatus: ACTIVE | INACTIVE
  status         String    @default("ACTIVE")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  classGroups  ClassGroup[]
  students     Student[]
  teachers     Teacher[]
  vehicles     Vehicle[]
  enrollments  Enrollment[]
  invoices     Invoice[]
  payments     Payment[]
  receipts     Receipt[]
  classrooms   Classroom[]
  classroomBookings  ClassroomBooking[]
  attendanceSessions AttendanceSession[]
  refunds            Refund[]

  @@map("branches")
}

model OrganizationSettings {
  id                String   @id @default(cuid())
  organizationId    String   @unique
  currencyCode      String   @default("MZN")
  currencySymbol    String   @default("MT")
  dateFormat        String   @default("DD/MM/YYYY")
  taxRate           Decimal? @db.Decimal(5, 2)
  taxName           String?
  invoicePrefix     String   @default("INV")
  receiptPrefix     String   @default("REC")
  allowLatePayments                            Boolean  @default(true)
  gracePeriodDays                              Int      @default(7)
  enableAutomaticOverdueProcessing             Boolean  @default(true)
  overdueGraceDays                             Int      @default(0)
  markInvoiceOverdueWhenAnyInstallmentOverdue  Boolean  @default(true)
  notifyOnOverdue                              Boolean  @default(true)
  overdueNotificationDelayDays                 Int      @default(0)
  createdAt                                    DateTime @default(now())
  updatedAt                                    DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("organization_settings")
}

// =============================================================================
// AUTHENTICATION (Auth.js / NextAuth compatible)
// =============================================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  avatarUrl     String?
  phone         String?
  passwordHash  String?
  emailVerified DateTime?
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  accounts          Account[]
  sessions          Session[]
  userOrganizations UserOrganization[]
  userRoles         UserRole[]
  notifications     Notification[]
  auditLogs         AuditLog[]         @relation("AuditActor")
  importJobs        ImportJob[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.NVarChar(Max)
  access_token      String? @db.NVarChar(Max)
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.NVarChar(Max)
  session_state     String?

  // Cascade is safe here — single path User → Account
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  // Cascade is safe here — single path User → Session
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model UserOrganization {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  isOwner        Boolean  @default(false)
  joinedAt       DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([userId, organizationId])
  @@map("user_organizations")
}

// =============================================================================
// ROLES & PERMISSIONS (RBAC)
// =============================================================================

model Role {
  id             String   @id @default(cuid())
  organizationId String?
  name           String
  code           String?
  description    String?
  isSystem       Boolean  @default(false)
  // RoleStatus: ACTIVE | ARCHIVED
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization    Organization?    @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([organizationId, name])
  @@unique([organizationId, code])
  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  module      String
  action      String
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id             String   @id @default(cuid())
  userId         String
  roleId         String
  organizationId String
  branchId       String?
  assignedAt     DateTime @default(now())
  assignedBy     String?

  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  role Role @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([userId, roleId, organizationId])
  @@map("user_roles")
}

// =============================================================================
// STUDENTS
// =============================================================================

model Student {
  id             String    @id @default(cuid())
  organizationId String
  branchId       String?
  code           String?
  firstName      String
  lastName       String
  email          String?
  phone          String?
  dateOfBirth    DateTime?
  // Gender: MALE | FEMALE | OTHER
  gender         String?
  address        String?
  photoUrl       String?
  idType         String?
  idNumber       String?
  // StudentStatus: PENDING | ACTIVE | SUSPENDED | COMPLETED | DROPPED
  status         String    @default("PENDING")
  notes          String?   @db.NVarChar(Max)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  createdBy      String?
  updatedBy      String?

  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branch           Branch?            @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  enrollments              Enrollment[]
  attendanceRecords        AttendanceRecord[]
  attendanceJustifications AttendanceJustification[]
  practicalLessons         PracticalLesson[]
  invoices                 Invoice[]
  payments                 Payment[]
  receipts                 Receipt[]
  wallets                    StudentWallet[]
  lessonProgress             StudentLessonProgress[]
  timelineEvents             StudentTimelineEvent[]
  assessmentResults          AssessmentResult[]
  studentSubjectProgress     StudentSubjectProgress[]
  assessmentRetakes          AssessmentRetake[]
  studentAssessmentResults   StudentAssessmentResult[]
  studentLevelProgress       StudentLevelProgress[]
  studentCourseProgress      StudentCourseProgress[]
  prerequisiteWaivers        PrerequisiteWaiver[]
  levelProgressionRequests   LevelProgressionRequest[]
  refunds                    Refund[]
  documents                  StudentDocument[]

  @@index([organizationId, branchId])
  @@map("students")
}

// =============================================================================
// TEACHERS
// =============================================================================

model Teacher {
  id             String    @id @default(cuid())
  organizationId String
  branchId       String?
  code           String?
  firstName      String
  lastName       String
  email          String?
  phone          String?
  dateOfBirth    DateTime?
  // Gender: MALE | FEMALE | OTHER
  gender         String?
  address        String?
  photoUrl       String?
  idType         String?
  idNumber       String?
  licenseNumber  String?
  specialization String?
  // TeacherStatus: ACTIVE | INACTIVE | ON_LEAVE
  status         String    @default("ACTIVE")
  notes          String?   @db.NVarChar(Max)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  createdBy      String?
  updatedBy      String?

  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branch             Branch?            @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  teacherSubjects    TeacherSubject[]
  classGroups        ClassGroup[]
  practicalLessons   PracticalLesson[]
  attendanceSessions AttendanceSession[]
  assessments        Assessment[]

  @@map("teachers")
}

// =============================================================================
// COURSES
// =============================================================================

model CourseCategory {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  description    String?
  // CourseCategoryStatus: ACTIVE | INACTIVE | ARCHIVED
  status         String    @default("ACTIVE")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  createdBy      String?
  updatedBy      String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  courses      Course[]

  @@unique([organizationId, name])
  @@map("course_categories")
}

model Course {
  id             String    @id @default(cuid())
  organizationId String
  categoryId     String?
  name           String
  code           String?
  description    String?   @db.NVarChar(Max)
  durationWeeks  Int?
  totalHours     Int?
  price          Decimal?  @db.Decimal(10, 2)
  isActive       Boolean   @default(true)
  // CourseStatus: DRAFT | ACTIVE | INACTIVE | ARCHIVED
  status         String    @default("DRAFT")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  createdBy      String?
  updatedBy      String?

  organization  Organization    @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  category      CourseCategory? @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  levels        CourseLevel[]
  levelSubjects LevelSubject[]
  classGroups   ClassGroup[]
  enrollments   Enrollment[]
  studentCourseProgress    StudentCourseProgress[]
  levelProgressionPolicies LevelProgressionPolicy[]
  levelProgressionRequests LevelProgressionRequest[]

  @@map("courses")
}

model CourseLevel {
  id            String   @id @default(cuid())
  courseId      String
  name          String
  code          String?
  description   String?
  order         Int      @default(0)
  durationWeeks Int?
  totalHours    Int?
  isActive      Boolean  @default(true)
  // CourseLevelStatus: ACTIVE | INACTIVE | ARCHIVED
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  course        Course         @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  levelSubjects LevelSubject[]
  classGroups   ClassGroup[]
  enrollments              Enrollment[]             @relation("CourseLevelEnrollments")
  initialEnrollments       Enrollment[]             @relation("InitialLevelEnrollments")
  currentEnrollments       Enrollment[]             @relation("CurrentLevelEnrollments")
  studentLevelProgress     StudentLevelProgress[]
  fromProgressionPolicies  LevelProgressionPolicy[] @relation("FromLevel")
  toProgressionPolicies    LevelProgressionPolicy[] @relation("ToLevel")
  fromProgressionRequests  LevelProgressionRequest[] @relation("FromLevelRequests")
  toProgressionRequests    LevelProgressionRequest[] @relation("ToLevelRequests")

  @@map("course_levels")
}

model Subject {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  code           String?
  description    String?   @db.NVarChar(Max)
  // SubjectStatus: ACTIVE | INACTIVE | ARCHIVED
  status         String    @default("ACTIVE")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization              Organization              @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  levelSubjects             LevelSubject[]
  teacherSubjects           TeacherSubject[]
  subjectLessons            SubjectLesson[]
  attendanceSessions        AttendanceSession[]
  studentAssessmentResults  StudentAssessmentResult[]

  @@unique([organizationId, code])
  @@map("subjects")
}

model LevelSubject {
  id                          String    @id @default(cuid())
  organizationId              String
  courseId                    String
  courseLevelId               String
  subjectId                   String
  order                       Int       @default(0)
  workloadHours               Int?
  theoryHours                 Int?
  practicalHours              Int?
  minimumPassingGrade         Decimal?  @db.Decimal(5, 2)
  minimumAttendancePercentage Decimal?  @db.Decimal(5, 2)
  maxAbsences                 Int?
  isRequired                  Boolean   @default(true)
  allowRetakeExam             Boolean   @default(true)
  allowCompensation           Boolean   @default(false)
  certificateRequired         Boolean   @default(false)
  credits                     Int?      @default(0)
  // LevelSubjectStatus: ACTIVE | INACTIVE | ARCHIVED
  status                      String    @default("ACTIVE")
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt
  deletedAt                   DateTime?

  organization           Organization             @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  course                 Course                   @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  courseLevel            CourseLevel              @relation(fields: [courseLevelId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subject                Subject                  @relation(fields: [subjectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assessmentPolicies         AssessmentPolicy[]
  studentSubjectProgress     StudentSubjectProgress[]
  studentAssessmentResults   StudentAssessmentResult[]
  prerequisiteGroups         LevelSubjectPrerequisiteGroup[]
  prerequisiteItemsAsPrereq  LevelSubjectPrerequisiteItem[]  @relation("PrerequisiteSubject")
  prerequisiteWaivers        PrerequisiteWaiver[]

  @@unique([courseLevelId, subjectId])
  @@map("level_subjects")
}

model TeacherSubject {
  id         String   @id @default(cuid())
  teacherId  String
  subjectId  String
  assignedAt DateTime @default(now())

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([teacherId, subjectId])
  @@map("teacher_subjects")
}

// =============================================================================
// CLASS GROUPS & SCHEDULES
// =============================================================================

model ClassGroup {
  id               String    @id @default(cuid())
  organizationId   String
  branchId         String?
  courseId         String
  courseLevelId    String?
  teacherId        String?
  academicYearId   String
  academicTermId   String?
  name             String
  code             String?
  capacity         Int       @default(30)
  currentCount     Int       @default(0)
  startDate        DateTime?
  endDate          DateTime?
  // ClassGroupStatus: FORMING | ACTIVE | COMPLETED | CANCELLED
  status           String    @default("FORMING")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
  createdBy        String?

  branch        Branch?           @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  course        Course            @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  courseLevel   CourseLevel?      @relation(fields: [courseLevelId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  teacher       Teacher?          @relation(fields: [teacherId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  academicYear  AcademicYear      @relation(fields: [academicYearId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  academicTerm  AcademicTerm?     @relation(fields: [academicTermId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  classGroupSchedules ClassGroupSchedule[]
  enrollments         Enrollment[]
  attendanceSessions  AttendanceSession[]
  classroomBookings   ClassroomBooking[]
  assessments         Assessment[]

  @@map("class_groups")
}

// =============================================================================
// SCHEDULE PERIODS & SLOTS
// Reusable, org-scoped schedule definitions.
// =============================================================================

model SchedulePeriod {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  code           String
  description    String?
  // ScheduleStatus: ACTIVE | INACTIVE | ARCHIVED
  status         String    @default("ACTIVE")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  slots        ScheduleSlot[]

  @@unique([organizationId, code])
  @@map("schedule_periods")
}

model ScheduleSlot {
  id               String    @id @default(cuid())
  organizationId   String
  schedulePeriodId String
  // DayOfWeek: MONDAY | TUESDAY | WEDNESDAY | THURSDAY | FRIDAY | SATURDAY | SUNDAY
  dayOfWeek        String
  startTime        String
  endTime          String
  // ScheduleStatus: ACTIVE | INACTIVE | ARCHIVED
  status           String    @default("ACTIVE")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  schedulePeriod      SchedulePeriod       @relation(fields: [schedulePeriodId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  classGroupSchedules ClassGroupSchedule[]
  classroomBookings   ClassroomBooking[]
  attendanceSessions  AttendanceSession[]

  @@unique([schedulePeriodId, dayOfWeek, startTime, endTime])
  @@map("schedule_slots")
}

model ClassGroupSchedule {
  id             String    @id @default(cuid())
  organizationId String
  classGroupId   String
  scheduleSlotId String
  // ScheduleStatus: ACTIVE | INACTIVE | ARCHIVED
  status         String    @default("ACTIVE")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  classGroup   ClassGroup   @relation(fields: [classGroupId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  scheduleSlot ScheduleSlot @relation(fields: [scheduleSlotId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([classGroupId, scheduleSlotId])
  @@map("class_group_schedules")
}

// =============================================================================
// BILLING POLICIES
// =============================================================================

model FeeDefinition {
  id             String    @id @default(cuid())
  organizationId String
  code           String
  name           String
  description    String?   @db.NVarChar(Max)
  // FeeType: REGISTRATION_FEE | COURSE_FEE | MATERIAL_FEE | EXAM_FEE | CERTIFICATE_FEE | PENALTY | OTHER
  feeType        String
  defaultAmount  Decimal   @db.Decimal(10, 2)
  // FeeAppliesTo: ENROLLMENT | COURSE | LEVEL | CERTIFICATE | EXAM | MANUAL
  appliesTo      String    @default("ENROLLMENT")
  isMandatory    Boolean   @default(false)
  priority       Int       @default(7)
  // FeeDefinitionStatus: ACTIVE | INACTIVE | ARCHIVED
  status         String    @default("ACTIVE")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  createdBy      String?
  updatedBy      String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  policyFees   PolicyFee[]

  @@unique([organizationId, code])
  @@map("fee_definitions")
}

model EnrollmentBillingPolicy {
  id                              String    @id @default(cuid())
  organizationId                  String
  name                            String
  description                     String?   @db.NVarChar(Max)
  autoGenerateInvoiceOnEnrollment Boolean   @default(true)
  // InvoiceMode: MANUAL | SINGLE_INVOICE | INSTALLMENT_INVOICES
  invoiceMode                     String    @default("SINGLE_INVOICE")
  // ActivationRule: MANUAL | AFTER_INVOICE_CREATED | AFTER_REGISTRATION_FEE | AFTER_FIRST_PAYMENT | AFTER_FULL_PAYMENT
  activationRule                  String    @default("MANUAL")
  installmentsRequired            Boolean   @default(false)
  defaultNumberOfInstallments     Int?
  minimumFirstPaymentAmount       Decimal?  @db.Decimal(10, 2)
  allowWalletCreditOnEnrollment   Boolean   @default(true)
  // BillingPolicyStatus: ACTIVE | INACTIVE | ARCHIVED
  status                          String    @default("ACTIVE")
  isDefault                       Boolean   @default(false)
  createdAt                       DateTime  @default(now())
  updatedAt                       DateTime  @updatedAt
  deletedAt                       DateTime?
  createdBy                       String?
  updatedBy                       String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  policyFees   PolicyFee[]
  enrollments  Enrollment[]
  invoices     Invoice[]

  @@unique([organizationId, name])
  @@map("enrollment_billing_policies")
}

model PolicyFee {
  id              String   @id @default(cuid())
  organizationId  String
  policyId        String
  feeDefinitionId String
  // PolicyFeeAmountType: FIXED | PERCENTAGE_OF_COURSE_PRICE | COURSE_BASE_PRICE
  amountType      String   @default("FIXED")
  fixedAmount     Decimal? @db.Decimal(10, 2)
  percentage      Decimal? @db.Decimal(5, 2)
  isRequired      Boolean  @default(true)
  priority        Int      @default(7)
  // PolicyFeeStatus: ACTIVE | INACTIVE
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization  Organization            @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  policy        EnrollmentBillingPolicy @relation(fields: [policyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  feeDefinition FeeDefinition           @relation(fields: [feeDefinitionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([policyId, feeDefinitionId])
  @@map("policy_fees")
}

model DiscountRule {
  id             String    @id @default(cuid())
  organizationId String
  code           String
  name           String
  description    String?   @db.NVarChar(Max)
  // DiscountType: PERCENTAGE | FIXED_AMOUNT
  discountType   String
  value          Decimal   @db.Decimal(10, 2)
  // DiscountAppliesTo: ENROLLMENT | COURSE | ALL
  appliesTo      String    @default("ENROLLMENT")
  startDate      DateTime?
  endDate        DateTime?
  stackable      Boolean   @default(false)
  // DiscountRuleStatus: ACTIVE | INACTIVE | ARCHIVED
  status         String    @default("ACTIVE")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  createdBy      String?
  updatedBy      String?

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  appliedDiscounts AppliedDiscount[]

  @@unique([organizationId, code])
  @@map("discount_rules")
}

model TaxRule {
  id                String    @id @default(cuid())
  organizationId    String
  code              String
  name              String
  description       String?   @db.NVarChar(Max)
  rate              Decimal   @db.Decimal(5, 2)
  // TaxAppliesTo: ENROLLMENT | COURSE | ALL
  appliesTo         String    @default("ENROLLMENT")
  isIncludedInPrice Boolean   @default(false)
  // TaxRuleStatus: ACTIVE | INACTIVE | ARCHIVED
  status            String    @default("ACTIVE")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?
  createdBy         String?
  updatedBy         String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  appliedTaxes AppliedTax[]

  @@unique([organizationId, code])
  @@map("tax_rules")
}

model AppliedDiscount {
  id             String   @id @default(cuid())
  organizationId String
  invoiceId      String
  discountRuleId String
  amount         Decimal  @db.Decimal(10, 2)
  description    String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  discountRule DiscountRule @relation(fields: [discountRuleId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organizationId, createdAt], name: "applied_discounts_org_createdat_idx")
  @@index([organizationId, discountRuleId, createdAt], name: "applied_discounts_org_rule_createdat_idx")
  @@index([organizationId, invoiceId], name: "applied_discounts_org_invoice_idx")
  @@map("applied_discounts")
}

model AppliedTax {
  id             String   @id @default(cuid())
  organizationId String
  invoiceId      String
  taxRuleId      String
  amount         Decimal  @db.Decimal(10, 2)
  rate           Decimal  @db.Decimal(5, 2)
  description    String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  taxRule      TaxRule      @relation(fields: [taxRuleId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("applied_taxes")
}

// =============================================================================
// ENROLLMENTS
// =============================================================================

model Enrollment {
  id               String    @id @default(cuid())
  organizationId   String
  branchId         String?
  studentId        String
  courseId         String
  courseLevelId    String?
  classGroupId     String?
  academicYearId   String
  academicTermId   String?
  billingPolicyId  String?
  enrollmentNumber String?
  enrollmentDate   DateTime  @default(now())
  startDate        DateTime?
  expectedEndDate  DateTime?
  initialLevelId   String?
  currentLevelId   String?
  // EnrollmentStatus: DRAFT | PENDING_PAYMENT | ACTIVE | COMPLETED | SUSPENDED | CANCELLED
  status           String    @default("DRAFT")
  notes            String?   @db.NVarChar(Max)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
  createdBy        String?
  updatedBy        String?

  branch         Branch?                   @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student        Student                   @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  course         Course                    @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  courseLevel    CourseLevel?              @relation("CourseLevelEnrollments", fields: [courseLevelId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  initialLevel   CourseLevel?              @relation("InitialLevelEnrollments", fields: [initialLevelId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  currentLevel   CourseLevel?              @relation("CurrentLevelEnrollments", fields: [currentLevelId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  classGroup     ClassGroup?               @relation(fields: [classGroupId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  academicYear   AcademicYear              @relation(fields: [academicYearId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  academicTerm   AcademicTerm?             @relation(fields: [academicTermId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  billingPolicy  EnrollmentBillingPolicy?  @relation(fields: [billingPolicyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  invoices               Invoice[]
  payments                 Payment[]
  statusHistory            EnrollmentStatusHistory[]
  lessonProgress           StudentLessonProgress[]
  assessmentResults        AssessmentResult[]
  studentSubjectProgress   StudentSubjectProgress[]
  assessmentRetakes        AssessmentRetake[]
  studentAssessmentResults StudentAssessmentResult[]
  studentLevelProgress     StudentLevelProgress[]
  studentCourseProgress    StudentCourseProgress?
  prerequisiteWaivers      PrerequisiteWaiver[]
  levelProgressionRequests LevelProgressionRequest[]
  refunds                  Refund[]

  @@unique([organizationId, enrollmentNumber])
  @@index([organizationId, courseId], name: "enrollments_org_course_idx")
  @@index([organizationId, enrollmentDate], name: "enrollments_org_enrollmentdate_idx")
  @@map("enrollments")
}

model EnrollmentStatusHistory {
  id           String    @id @default(cuid())
  enrollmentId String
  fromStatus   String?
  toStatus     String
  reason       String?
  changedBy    String?
  changedAt    DateTime  @default(now())

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("enrollment_status_history")
}

// =============================================================================
// ATTENDANCE
// =============================================================================

model AttendanceSession {
  id              String    @id @default(cuid())
  organizationId  String
  branchId        String?
  academicYearId  String
  academicTermId  String?
  classGroupId    String
  courseId        String
  courseLevelId   String
  subjectId       String
  levelSubjectId  String
  teacherId       String?
  classroomId     String?
  scheduleSlotId  String?
  sessionDate     DateTime
  startTime       String
  endTime         String
  durationMinutes Int
  title           String?
  notes           String?   @db.NVarChar(Max)
  // AttendanceSessionStatus: DRAFT | OPEN | COMPLETED | CANCELLED | ARCHIVED
  status          String    @default("DRAFT")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  createdBy       String?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branch       Branch?       @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  academicYear AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  academicTerm AcademicTerm? @relation(fields: [academicTermId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  classGroup   ClassGroup    @relation(fields: [classGroupId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subject      Subject       @relation(fields: [subjectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  teacher      Teacher?      @relation(fields: [teacherId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  classroom    Classroom?    @relation(fields: [classroomId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  scheduleSlot ScheduleSlot? @relation(fields: [scheduleSlotId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  records      AttendanceRecord[]

  @@index([organizationId, classGroupId, sessionDate])
  @@index([organizationId, status])
  @@index([organizationId, status, sessionDate], name: "attendance_sessions_org_status_sessiondate_idx")
  @@map("attendance_sessions")
}

model AttendanceRecord {
  id                  String    @id @default(cuid())
  organizationId      String
  attendanceSessionId String
  studentId           String
  enrollmentId        String?
  // AttendanceRecordStatus: PRESENT | ABSENT | LATE | EXCUSED | REMOTE
  status              String    @default("ABSENT")
  checkInAt           DateTime?
  checkOutAt          DateTime?
  minutesAttended     Int       @default(0)
  lateMinutes         Int?
  markedByUserId      String?
  markedAt            DateTime?
  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  attendanceSession AttendanceSession @relation(fields: [attendanceSessionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student           Student           @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  justifications    AttendanceJustification[]

  @@unique([attendanceSessionId, studentId])
  @@index([organizationId, studentId])
  @@map("attendance_records")
}

model AttendanceJustification {
  id                 String    @id @default(cuid())
  organizationId     String
  attendanceRecordId String
  studentId          String
  reason             String    @db.NVarChar(Max)
  attachmentUrl      String?
  // AttendanceJustificationStatus: PENDING | APPROVED | REJECTED
  status             String    @default("PENDING")
  reviewedByUserId   String?
  reviewedAt         DateTime?
  reviewNotes        String?   @db.NVarChar(Max)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  attendanceRecord  AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student           Student          @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organizationId, studentId])
  @@index([organizationId, status])
  @@map("attendance_justifications")
}

// =============================================================================
// VEHICLES
// =============================================================================

model Vehicle {
  id             String    @id @default(cuid())
  organizationId String
  branchId       String?
  plate          String
  brand          String?
  model          String?
  year           Int?
  color          String?
  category       String?
  transmission   String?
  // VehicleStatus: ACTIVE | MAINTENANCE | INACTIVE
  status         String    @default("ACTIVE")
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  createdBy      String?

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branch           Branch?           @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  practicalLessons PracticalLesson[]

  @@map("vehicles")
}

// =============================================================================
// PRACTICAL LESSONS
// =============================================================================

model PracticalLesson {
  id              String    @id @default(cuid())
  organizationId  String
  studentId       String
  teacherId       String?
  vehicleId       String?
  date            DateTime
  startTime       String
  endTime         String
  durationMinutes Int?
  // PracticalLessonStatus: SCHEDULED | IN_PROGRESS | COMPLETED | CANCELLED | NO_SHOW
  status          String    @default("SCHEDULED")
  evaluation      String?   @db.NVarChar(Max)
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdBy       String?

  student Student  @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  teacher Teacher? @relation(fields: [teacherId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("practical_lessons")
}

// =============================================================================
// FINANCIAL MODULE
// =============================================================================

model Invoice {
  id              String    @id @default(cuid())
  organizationId  String
  branchId        String?
  enrollmentId    String?
  studentId       String?
  billingPolicyId String?
  invoiceNumber   String
  issueDate       DateTime  @default(now())
  dueDate         DateTime?
  subtotal        Decimal   @db.Decimal(10, 2)
  discountAmount  Decimal   @db.Decimal(10, 2) @default(0)
  taxAmount       Decimal   @db.Decimal(10, 2) @default(0)
  totalAmount     Decimal   @db.Decimal(10, 2)
  paidAmount      Decimal   @db.Decimal(10, 2) @default(0)
  balanceAmount   Decimal   @db.Decimal(10, 2) @default(0)
  // InvoiceStatus: PENDING | PARTIALLY_PAID | PAID | OVERDUE | CANCELLED
  status          String    @default("PENDING")
  notes           String?   @db.NVarChar(Max)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  createdBy       String?
  updatedBy       String?

  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branch         Branch?                  @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student        Student?                 @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  enrollment     Enrollment?              @relation(fields: [enrollmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  billingPolicy  EnrollmentBillingPolicy? @relation(fields: [billingPolicyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  items          InvoiceItem[]
  payments       Payment[]
  paymentPlan    PaymentPlan?
  receipts       Receipt[]
  allocations    PaymentAllocation[]
  appliedDiscounts AppliedDiscount[]
  appliedTaxes     AppliedTax[]
  refunds          Refund[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, studentId, status], name: "invoices_org_student_status_idx")
  @@index([organizationId, status, dueDate], name: "invoices_org_status_duedate_idx")
  @@index([organizationId, status, issueDate], name: "invoices_org_status_issuedate_idx")
  @@index([organizationId, branchId, status, issueDate], name: "invoices_org_branch_status_issuedate_idx")
  @@index([organizationId, enrollmentId, status], name: "invoices_org_enrollment_status_idx")
  @@map("invoices")
}

model InvoiceItem {
  id              String   @id @default(cuid())
  organizationId  String
  invoiceId       String
  feeDefinitionId String?
  // InvoiceItemType: REGISTRATION_FEE | COURSE_FEE | MATERIAL_FEE | EXAM_FEE | CERTIFICATE_FEE | PENALTY | OTHER
  itemType        String   @default("OTHER")
  description     String
  quantity        Decimal  @db.Decimal(10, 2) @default(1)
  unitPrice       Decimal  @db.Decimal(10, 2)
  totalPrice      Decimal  @db.Decimal(10, 2)
  paidAmount      Decimal  @db.Decimal(10, 2) @default(0)
  balanceAmount   Decimal  @db.Decimal(10, 2) @default(0)
  priority        Int      @default(7)
  // InvoiceItemStatus: PENDING | PARTIALLY_PAID | PAID
  status          String   @default("PENDING")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Cascade is safe here — Invoice is the single owner of its items
  invoice     Invoice             @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  allocations PaymentAllocation[]

  @@map("invoice_items")
}

model PaymentPlan {
  id                   String   @id @default(cuid())
  organizationId       String
  invoiceId            String   @unique
  name                 String
  numberOfInstallments Int
  totalAmount          Decimal  @db.Decimal(10, 2)
  // PaymentPlanStatus: ACTIVE | COMPLETED | CANCELLED
  status               String   @default("ACTIVE")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  invoice         Invoice       @relation(fields: [invoiceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  installmentList Installment[]

  @@map("payment_plans")
}

model Installment {
  id                String    @id @default(cuid())
  organizationId    String
  paymentPlanId     String
  invoiceId         String
  installmentNumber Int
  dueDate           DateTime
  amount            Decimal   @db.Decimal(10, 2)
  paidAmount        Decimal   @db.Decimal(10, 2) @default(0)
  balanceAmount     Decimal   @db.Decimal(10, 2) @default(0)
  // InstallmentStatus: PENDING | PARTIALLY_PAID | PAID | OVERDUE
  status            String    @default("PENDING")
  paidAt            DateTime?

  paymentPlan PaymentPlan @relation(fields: [paymentPlanId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payments    Payment[]

  @@index([organizationId, status, dueDate], name: "installments_org_status_duedate_idx")
  @@index([organizationId, invoiceId, status], name: "installments_org_invoice_status_idx")
  @@map("installments")
}

model Payment {
  id            String   @id @default(cuid())
  organizationId String
  branchId      String?
  invoiceId     String?
  installmentId String?
  studentId     String?
  enrollmentId  String?
  paymentNumber String
  paymentDate   DateTime @default(now())
  totalAmount   Decimal  @db.Decimal(10, 2)
  // PaymentStatus: PENDING | CONFIRMED | CANCELLED | REFUNDED
  status        String   @default("PENDING")
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdBy     String?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branch       Branch?       @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student      Student?      @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  invoice      Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  installment  Installment?  @relation(fields: [installmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  enrollment   Enrollment?   @relation(fields: [enrollmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  receipt            Receipt?
  splits             PaymentSplit[]
  creditApplications CreditApplication[]
  allocations        PaymentAllocation[]
  refunds            Refund[]

  @@unique([organizationId, paymentNumber])
  @@index([organizationId, status, paymentDate], name: "payments_org_status_paymentdate_idx")
  @@index([organizationId, branchId, status, paymentDate], name: "payments_org_branch_status_paymentdate_idx")
  @@index([organizationId, invoiceId, status], name: "payments_org_invoice_status_idx")
  @@map("payments")
}

model Receipt {
  id             String   @id @default(cuid())
  organizationId String
  branchId       String?
  paymentId      String   @unique
  invoiceId      String
  studentId      String?
  receiptNumber  String
  issueDate      DateTime @default(now())
  amount         Decimal  @db.Decimal(10, 2)
  refundedAmount Decimal  @db.Decimal(10, 2) @default(0)
  // ReceiptStatus: ISSUED | PARTIALLY_REFUNDED | CANCELLED
  status             String    @default("ISSUED")
  issuedBy           String?
  cancelledAt        DateTime?
  cancelledBy        String?
  cancellationReason String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payment      Payment      @relation(fields: [paymentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student      Student?     @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  refunds      Refund[]

  @@unique([organizationId, receiptNumber])
  @@map("receipts")
}

model PaymentSplit {
  id             String   @id @default(cuid())
  organizationId String
  paymentId      String
  // PaymentMethod: CASH | BANK_TRANSFER | MPESA | EMOLA | POS | CARD | CHEQUE | OTHER
  method         String
  amount         Decimal  @db.Decimal(15, 2)
  reference      String?
  notes          String?  @db.NVarChar(Max)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payment      Payment      @relation(fields: [paymentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organizationId, method, createdAt], name: "payment_splits_org_method_createdat_idx")
  @@index([paymentId, method], name: "payment_splits_payment_method_idx")
  @@map("payment_splits")
}

model PaymentAllocation {
  id                  String   @id @default(cuid())
  organizationId      String
  paymentId           String?
  creditApplicationId String?
  invoiceId           String
  invoiceItemId       String
  amount              Decimal  @db.Decimal(10, 2)
  // AllocationType: PAYMENT | WALLET_CREDIT | ADJUSTMENT | REFUND_REVERSAL
  allocationType      String   @default("PAYMENT")
  createdAt           DateTime @default(now())
  createdBy           String?

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payment           Payment?           @relation(fields: [paymentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  creditApplication CreditApplication? @relation(fields: [creditApplicationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  invoice           Invoice            @relation(fields: [invoiceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  invoiceItem       InvoiceItem        @relation(fields: [invoiceItemId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // Reconciliation Report: SUM(amount) GROUP BY invoiceId vs Invoice.paidAmount
  @@index([organizationId, invoiceId], name: "payment_allocations_org_invoice_idx")
  @@map("payment_allocations")
}

// =============================================================================
// STUDENT WALLET
// =============================================================================

model StudentWallet {
  id             String   @id @default(cuid())
  organizationId String
  studentId      String
  // WalletStatus: ACTIVE | SUSPENDED
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      String?

  organization       Organization               @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student            Student                    @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  transactions       StudentWalletTransaction[]
  creditApplications CreditApplication[]

  @@unique([organizationId, studentId])
  @@map("student_wallets")
}

model StudentWalletTransaction {
  id              String   @id @default(cuid())
  organizationId  String
  studentWalletId String
  // WalletTransactionType: DEPOSIT | OVERPAYMENT | CREDIT_APPLIED | REFUND | ADJUSTMENT | PROMOTIONAL_CREDIT
  type            String
  // Signed: positive = credit to wallet; negative = debit from wallet
  amount          Decimal  @db.Decimal(15, 2)
  referenceType   String?
  referenceId     String?
  description     String?  @db.NVarChar(Max)
  createdAt       DateTime @default(now())
  createdBy       String?

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  wallet       StudentWallet  @relation(fields: [studentWalletId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([studentWalletId, createdAt])
  @@index([organizationId, type, createdAt])
  @@index([organizationId, createdAt], name: "swt_org_createdat_idx")
  @@map("student_wallet_transactions")
}

model CreditApplication {
  id              String   @id @default(cuid())
  organizationId  String
  studentId       String
  studentWalletId String
  invoiceId       String
  // Optional link to a Payment when credit is applied as part of a payment transaction
  paymentId       String?
  amount          Decimal  @db.Decimal(15, 2)
  notes           String?  @db.NVarChar(Max)
  createdAt       DateTime @default(now())
  createdBy       String?

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  wallet       StudentWallet      @relation(fields: [studentWalletId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payment      Payment?           @relation(fields: [paymentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  allocations  PaymentAllocation[]

  @@map("credit_applications")
}

// =============================================================================
// NOTIFICATIONS
// =============================================================================

model Notification {
  id             String    @id @default(cuid())
  organizationId String
  userId         String?
  // NotificationType: ENROLLMENT_APPROVED | ENROLLMENT_CANCELLED | PAYMENT_RECEIVED |
  //                   PAYMENT_OVERDUE | CLASS_SCHEDULED | CLASS_CANCELLED | DOCUMENT_READY | GENERAL
  type           String
  // NotificationChannel: IN_APP | EMAIL | SMS | WHATSAPP
  channel        String    @default("IN_APP")
  title          String
  body           String    @db.NVarChar(Max)
  data           String?   @db.NVarChar(Max)
  isRead         Boolean   @default(false)
  readAt         DateTime?
  sentAt         DateTime?
  // NotificationStatus: PENDING | SENT | FAILED | READ
  status         String    @default("PENDING")
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user         User?        @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("notifications")
}

// =============================================================================
// LESSONS & CONTENT LIBRARY
// =============================================================================

model Lesson {
  id               String    @id @default(cuid())
  organizationId   String
  title            String
  slug             String
  description      String?   @db.NVarChar(Max)
  summary          String?   @db.NVarChar(Max)
  objectives       String?   @db.NVarChar(Max)
  durationMinutes  Int?
  // LessonType: VIDEO | TEXT | LIVE | PRACTICAL | READING | ASSIGNMENT_PREP
  lessonType       String    @default("TEXT")
  // VideoProvider: YOUTUBE | VIMEO | CLOUDFLARE_STREAM | BUNNY | S3 | EXTERNAL | NONE
  videoProvider    String    @default("NONE")
  videoUrl         String?   @db.NVarChar(Max)
  externalVideoId  String?
  thumbnailUrl     String?   @db.NVarChar(Max)
  // LessonStatus: DRAFT | PUBLISHED | ARCHIVED
  status           String    @default("DRAFT")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  organization    Organization            @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  attachments     LessonAttachment[]
  subjectLessons  SubjectLesson[]
  lessonProgress  StudentLessonProgress[]

  @@unique([organizationId, slug])
  @@map("lessons")
}

model LessonAttachment {
  id               String    @id @default(cuid())
  organizationId   String
  lessonId         String
  fileName         String
  fileUrl          String    @db.NVarChar(Max)
  // FileType: PDF | IMAGE | DOCUMENT | SPREADSHEET | PRESENTATION | AUDIO | VIDEO | OTHER
  fileType         String    @default("OTHER")
  fileSize         Int?
  isDownloadable   Boolean   @default(true)
  // LessonAttachmentStatus: ACTIVE | ARCHIVED
  status           String    @default("ACTIVE")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lesson       Lesson       @relation(fields: [lessonId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("lesson_attachments")
}

model SubjectLesson {
  id                  String    @id @default(cuid())
  organizationId      String
  subjectId           String
  lessonId            String
  order               Int       @default(0)
  isRequired          Boolean   @default(false)
  minWatchPercentage  Int       @default(0)
  unlockAfterLessonId String?
  // SubjectLessonStatus: ACTIVE | INACTIVE | ARCHIVED
  status              String    @default("ACTIVE")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subject      Subject                @relation(fields: [subjectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lesson       Lesson                 @relation(fields: [lessonId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  unlockAfter  SubjectLesson?         @relation("UnlockChain", fields: [unlockAfterLessonId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  unlockedBy   SubjectLesson[]        @relation("UnlockChain")
  lessonProgress StudentLessonProgress[]

  @@unique([subjectId, lessonId])
  @@unique([subjectId, order])
  @@map("subject_lessons")
}

model StudentLessonProgress {
  id                String    @id @default(cuid())
  organizationId    String
  studentId         String
  enrollmentId      String
  subjectId         String
  lessonId          String
  subjectLessonId   String?
  watchedSeconds    Int       @default(0)
  progressPercentage Decimal  @db.Decimal(5, 2) @default(0)
  // ProgressStatus: NOT_STARTED | IN_PROGRESS | COMPLETED
  status            String    @default("NOT_STARTED")
  completedAt       DateTime?
  lastAccessedAt    DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student        Student        @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  enrollment     Enrollment     @relation(fields: [enrollmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lesson         Lesson         @relation(fields: [lessonId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subjectLesson  SubjectLesson? @relation(fields: [subjectLessonId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([studentId, enrollmentId, lessonId])
  @@map("student_lesson_progress")
}

// =============================================================================
// AUDIT LOGS
// =============================================================================

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  actorId        String?
  entity         String
  entityId       String
  action         String
  oldValues      String?  @db.NVarChar(Max)
  newValues      String?  @db.NVarChar(Max)
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  actor        User?         @relation("AuditActor", fields: [actorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organizationId, entity, entityId])
  @@index([organizationId, actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

// =============================================================================
// ACADEMIC CALENDAR
// =============================================================================

model AcademicYear {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  code           String
  startDate      DateTime
  endDate        DateTime
  // AcademicYearStatus: DRAFT | ACTIVE | COMPLETED | CANCELLED | ARCHIVED
  status         String    @default("DRAFT")
  isDefault      Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  terms              AcademicTerm[]
  holidays           AcademicHoliday[]
  events             AcademicEvent[]
  classGroups        ClassGroup[]
  enrollments        Enrollment[]
  classroomBookings  ClassroomBooking[]
  attendanceSessions AttendanceSession[]
  assessmentPeriods  AssessmentPeriod[]
  assessments        Assessment[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@map("academic_years")
}

model AcademicTerm {
  id             String    @id @default(cuid())
  organizationId String
  academicYearId String
  name           String
  code           String
  startDate      DateTime
  endDate        DateTime
  order          Int
  // AcademicTermStatus: DRAFT | ACTIVE | COMPLETED | CANCELLED | ARCHIVED
  status         String    @default("DRAFT")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  academicYear       AcademicYear       @relation(fields: [academicYearId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  events             AcademicEvent[]
  classGroups        ClassGroup[]
  enrollments        Enrollment[]
  classroomBookings  ClassroomBooking[]
  attendanceSessions AttendanceSession[]
  assessmentPeriods  AssessmentPeriod[]
  assessments        Assessment[]

  @@unique([academicYearId, order])
  @@unique([academicYearId, code])
  @@index([organizationId, academicYearId])
  @@map("academic_terms")
}

model AcademicHoliday {
  id             String    @id @default(cuid())
  organizationId String
  academicYearId String?
  name           String
  description    String?   @db.NVarChar(Max)
  startDate      DateTime
  endDate        DateTime
  isRecurring    Boolean   @default(false)
  // AcademicHolidayStatus: DRAFT | ACTIVE | COMPLETED | CANCELLED | ARCHIVED
  status         String    @default("ACTIVE")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organizationId, academicYearId])
  @@map("academic_holidays")
}

model AcademicEvent {
  id             String    @id @default(cuid())
  organizationId String
  academicYearId String?
  academicTermId String?
  title          String
  description    String?   @db.NVarChar(Max)
  // AcademicEventType: GENERAL | EXAM_PERIOD | ENROLLMENT_PERIOD | PAYMENT_DEADLINE | HOLIDAY | TEACHER_MEETING | GRADUATION | OTHER
  eventType      String    @default("GENERAL")
  startDate      DateTime
  endDate        DateTime
  // AcademicEventStatus: DRAFT | ACTIVE | COMPLETED | CANCELLED | ARCHIVED
  status         String    @default("DRAFT")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  academicTerm AcademicTerm? @relation(fields: [academicTermId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organizationId, academicYearId])
  @@index([organizationId, eventType])
  @@map("academic_events")
}

// =============================================================================
// CLASSROOM MANAGEMENT
// =============================================================================

model Classroom {
  id             String    @id @default(cuid())
  organizationId String
  branchId       String?

  code        String
  name        String
  description String?   @db.NVarChar(Max)

  // ClassroomType: STANDARD_ROOM | COMPUTER_LAB | LANGUAGE_LAB | DESIGN_STUDIO |
  //                DRIVING_ROOM | MEETING_ROOM | ONLINE_ROOM | OTHER
  classroomType String    @default("STANDARD_ROOM")
  capacity      Int       @default(1)

  location String?
  floor    String?

  // MeetingProvider: ZOOM | GOOGLE_MEET | MICROSOFT_TEAMS | CUSTOM
  meetingProvider String?
  meetingUrl      String?   @db.NVarChar(Max)

  // ClassroomStatus: ACTIVE | MAINTENANCE | INACTIVE | ARCHIVED
  status String @default("ACTIVE")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization       Organization           @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branch             Branch?                @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  features           ClassroomFeature[]
  resources          ClassroomResource[]
  maintenances       ClassroomMaintenance[]
  bookings           ClassroomBooking[]
  attendanceSessions AttendanceSession[]

  @@index([organizationId, branchId, code])
  @@index([organizationId, status])
  @@map("classrooms")
}

model ClassroomFeature {
  id             String @id @default(cuid())
  organizationId String
  classroomId    String

  // ClassroomFeatureType: AIR_CONDITIONING | INTERNET | PROJECTOR | SMART_BOARD |
  //                       RECORDING | ACCESSIBLE | SOUND_SYSTEM | CCTV | GENERATOR | OTHER
  feature String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  classroom    Classroom    @relation(fields: [classroomId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([classroomId, feature])
  @@map("classroom_features")
}

model ClassroomResource {
  id             String @id @default(cuid())
  organizationId String
  classroomId    String

  name        String
  quantity    Int       @default(0)
  description String?

  // ClassroomResourceStatus: ACTIVE | INACTIVE | ARCHIVED
  status String @default("ACTIVE")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  classroom    Classroom    @relation(fields: [classroomId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("classroom_resources")
}

model ClassroomMaintenance {
  id             String @id @default(cuid())
  organizationId String
  classroomId    String

  title       String
  description String?   @db.NVarChar(Max)
  startDate   DateTime
  endDate     DateTime

  // ClassroomMaintenanceStatus: SCHEDULED | IN_PROGRESS | COMPLETED | CANCELLED
  status String @default("SCHEDULED")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  classroom    Classroom    @relation(fields: [classroomId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organizationId, classroomId, status])
  @@map("classroom_maintenances")
}

model ClassroomBooking {
  id             String  @id @default(cuid())
  organizationId String
  branchId       String?

  classroomId    String
  classGroupId   String?
  scheduleSlotId String?

  academicYearId String
  academicTermId String?

  startDate DateTime
  endDate   DateTime

  // ClassroomBookingStatus: ACTIVE | COMPLETED | CANCELLED | ARCHIVED
  status String @default("ACTIVE")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branch         Branch?       @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  classroom      Classroom     @relation(fields: [classroomId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  classGroup     ClassGroup?   @relation(fields: [classGroupId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  scheduleSlot   ScheduleSlot? @relation(fields: [scheduleSlotId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  academicYear   AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  academicTerm   AcademicTerm? @relation(fields: [academicTermId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organizationId, classroomId, status])
  @@index([organizationId, academicYearId])
  @@map("classroom_bookings")
}

// =============================================================================
// STUDENT TIMELINE
// =============================================================================

model StudentTimelineEvent {
  id             String    @id @default(cuid())
  organizationId String
  studentId      String

  // TimelineEventType: ENROLLMENT_CREATED | ENROLLMENT_ACTIVATED | ENROLLMENT_CANCELLED |
  //   INVOICE_CREATED | INVOICE_PAID | PAYMENT_CONFIRMED | RECEIPT_ISSUED |
  //   WALLET_DEPOSIT_CREATED | WALLET_CREDIT_APPLIED | WALLET_OVERPAYMENT_CREATED |
  //   LESSON_COMPLETED | CLASS_GROUP_ASSIGNED | CLASSROOM_BOOKING_CHANGED |
  //   NOTIFICATION_SENT | MANUAL_NOTE
  eventType      String

  title          String
  description    String?   @db.NVarChar(Max)

  // TimelineReferenceType: ENROLLMENT | INVOICE | PAYMENT | RECEIPT | WALLET |
  //   LESSON | CLASS_GROUP | CLASSROOM_BOOKING | NOTIFICATION | USER | SYSTEM
  referenceType  String?
  referenceId    String?

  sourceEventId  String?   // DomainEvent.id — used for idempotency
  actorUserId    String?

  // TimelineVisibility: INTERNAL | STUDENT_VISIBLE
  visibility     String    @default("INTERNAL")

  metadata       String?   @db.NVarChar(Max)

  occurredAt     DateTime
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organizationId, studentId, occurredAt])
  @@index([organizationId, studentId, eventType])
  @@index([sourceEventId])
  @@index([organizationId, occurredAt], name: "student_timeline_events_org_occurredat_idx")
  @@map("student_timeline_events")
}

// =============================================================================
// DOMAIN EVENTS
// =============================================================================

model DomainEvent {
  id             String    @id @default(cuid())
  organizationId String
  eventType      String
  aggregateType  String
  aggregateId    String
  payload        String    @db.NVarChar(Max)
  // DomainEventStatus: PENDING | PROCESSING | PROCESSED | FAILED | CANCELLED
  status         String    @default("PENDING")
  occurredAt     DateTime  @default(now())
  processedAt    DateTime?
  failedAt       DateTime?
  failureReason  String?   @db.NVarChar(Max)
  retryCount     Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization  Organization           @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  handlerLogs   DomainEventHandlerLog[]

  @@index([organizationId, eventType, status])
  @@index([organizationId, aggregateType, aggregateId])
  @@index([organizationId, status, occurredAt])
  @@map("domain_events")
}

model DomainEventHandlerLog {
  id             String    @id @default(cuid())
  organizationId String
  eventId        String
  handlerName    String
  // DomainEventHandlerStatus: PENDING | PROCESSING | PROCESSED | FAILED | SKIPPED
  status         String    @default("PENDING")
  startedAt      DateTime?
  completedAt    DateTime?
  failedAt       DateTime?
  failureReason  String?   @db.NVarChar(Max)
  retryCount     Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  event        DomainEvent  @relation(fields: [eventId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([eventId, handlerName])
  @@index([organizationId, eventId])
  @@index([organizationId, handlerName, status])
  @@map("domain_event_handler_logs")
}

// =============================================================================
// IMPORT JOBS
// =============================================================================

model ImportJob {
  id               String    @id @default(cuid())
  organizationId   String
  // ImportJobType: STUDENTS | TEACHERS | ENROLLMENTS | CLASS_GROUPS | COURSES | SUBJECTS
  type             String    @default("STUDENTS")
  // ImportJobStatus: PENDING | VALIDATED | PROCESSING | COMPLETED | FAILED
  status           String    @default("PENDING")
  uploadedFileName String
  totalRows        Int       @default(0)
  successRows      Int       @default(0)
  failedRows       Int       @default(0)
  rowsData         String?   @db.NVarChar(Max)
  resultData       String?   @db.NVarChar(Max)
  validationSummary String?  @db.NVarChar(Max)
  executionSummary  String?  @db.NVarChar(Max)
  startedAt        DateTime?
  completedAt      DateTime?
  uploadedById     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  uploadedBy   User?        @relation(fields: [uploadedById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@map("import_jobs")
}

// =============================================================================
// ASSESSMENTS
// =============================================================================

model AssessmentPolicy {
  id                  String    @id @default(cuid())
  organizationId      String
  levelSubjectId      String
  name                String
  description         String?   @db.NVarChar(Max)
  // CalculationMethod: WEIGHTED_AVERAGE | SIMPLE_AVERAGE
  calculationMethod   String    @default("WEIGHTED_AVERAGE")
  // RoundingMethod: NONE | NEAREST_INTEGER | ONE_DECIMAL | TWO_DECIMALS
  roundingMethod      String    @default("NONE")
  minimumPassingGrade Decimal   @db.Decimal(5, 2)
  allowRetake         Boolean   @default(true)
  maxRetakes          Int       @default(1)
  allowRecovery       Boolean   @default(false)
  // AssessmentPolicyStatus: ACTIVE | INACTIVE | ARCHIVED
  status              String    @default("ACTIVE")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  levelSubject LevelSubject     @relation(fields: [levelSubjectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  components   AssessmentComponent[]
  assessments  Assessment[]

  @@index([organizationId, levelSubjectId, status])
  @@map("assessment_policies")
}

model AssessmentComponent {
  id                 String    @id @default(cuid())
  organizationId     String
  assessmentPolicyId String
  name               String
  // ComponentType: TEST | QUIZ | EXAM | ASSIGNMENT | PROJECT | ORAL | PRACTICAL | PARTICIPATION | FINAL_EXAM | RECOVERY | OTHER
  componentType      String    @default("TEST")
  weight             Decimal   @db.Decimal(5, 2)
  maxGrade           Decimal   @db.Decimal(5, 2) @default(20)
  order              Int       @default(0)
  isRequired         Boolean   @default(true)
  // AssessmentComponentStatus: ACTIVE | INACTIVE | ARCHIVED
  status             String    @default("ACTIVE")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assessmentPolicy AssessmentPolicy @relation(fields: [assessmentPolicyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assessments      Assessment[]
  gradeResults     StudentAssessmentResult[]

  @@index([organizationId, assessmentPolicyId, status])
  @@map("assessment_components")
}

model AssessmentPeriod {
  id             String    @id @default(cuid())
  organizationId String
  academicYearId String
  academicTermId String?
  name           String
  code           String
  startDate      DateTime
  endDate        DateTime
  order          Int       @default(0)
  // AssessmentPeriodStatus: ACTIVE | INACTIVE | ARCHIVED
  status         String    @default("ACTIVE")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  academicYear AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  academicTerm AcademicTerm? @relation(fields: [academicTermId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assessments  Assessment[]

  @@unique([organizationId, code])
  @@index([organizationId, academicYearId, status])
  @@map("assessment_periods")
}

model Assessment {
  id                    String    @id @default(cuid())
  organizationId        String
  assessmentPolicyId    String
  assessmentComponentId String
  assessmentPeriodId    String
  academicYearId        String
  academicTermId        String?
  classGroupId          String
  courseId              String
  courseLevelId         String
  levelSubjectId        String
  subjectId             String
  teacherId             String?
  title                 String
  description           String?   @db.NVarChar(Max)
  assessmentDate        DateTime
  maxScore              Decimal   @db.Decimal(5, 2)
  // AssessmentStatus: DRAFT | SCHEDULED | OPEN | GRADED | CANCELLED | ARCHIVED
  status                String    @default("DRAFT")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?
  createdBy             String?

  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assessmentPolicy    AssessmentPolicy    @relation(fields: [assessmentPolicyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assessmentComponent AssessmentComponent @relation(fields: [assessmentComponentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
