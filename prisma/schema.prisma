// =============================================================================
// SCHOOL MANAGEMENT SAAS - DATABASE SCHEMA
// Provider: SQL Server | ORM: Prisma
// Note: SQL Server does not support enums OR multiple cascade paths.
//       All status fields use String. All relations use NoAction except where
//       a single-path cascade is safe (Account→User, InvoiceItem→Invoice).
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
}

// =============================================================================
// ORGANIZATIONS & TENANCY
// =============================================================================

model Organization {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  email     String?
  phone     String?
  address   String?
  logoUrl   String?
  // OrganizationStatus: TRIAL | ACTIVE | SUSPENDED | CANCELLED
  status    String    @default("TRIAL")
  // SubscriptionPlan: FREE | STARTER | PROFESSIONAL | ENTERPRISE
  plan      String    @default("FREE")
  timezone  String    @default("UTC")
  locale    String    @default("en")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  branches                   Branch[]
  userOrganizations          UserOrganization[]
  students                   Student[]
  teachers                   Teacher[]
  courses                    Course[]
  courseCategories           CourseCategory[]
  subjects                   Subject[]
  levelSubjects              LevelSubject[]
  lessons                    Lesson[]
  lessonAttachments          LessonAttachment[]
  subjectLessons             SubjectLesson[]
  lessonProgress             StudentLessonProgress[]
  vehicles                   Vehicle[]
  invoices                   Invoice[]
  payments                   Payment[]
  receipts                   Receipt[]
  paymentSplits              PaymentSplit[]
  paymentAllocations         PaymentAllocation[]
  studentWallets             StudentWallet[]
  walletTransactions         StudentWalletTransaction[]
  creditApplications         CreditApplication[]
  roles                      Role[]
  auditLogs                  AuditLog[]
  notifications              Notification[]
  notificationTemplates      NotificationTemplate[]
  notificationEventRules     NotificationEventRule[]
  notificationDeliveries     NotificationDelivery[]
  notificationEmailSettings  NotificationEmailSettings?
  settings                   OrganizationSettings?
  schedulePeriods            SchedulePeriod[]
  scheduleSlots              ScheduleSlot[]
  classGroupSchedules        ClassGroupSchedule[]
  feeDefinitions             FeeDefinition[]
  enrollmentBillingPolicies  EnrollmentBillingPolicy[]
  policyFees                 PolicyFee[]
  discountRules              DiscountRule[]
  taxRules                   TaxRule[]
  appliedDiscounts           AppliedDiscount[]
  appliedTaxes               AppliedTax[]
  academicYears              AcademicYear[]
  academicTerms              AcademicTerm[]
  academicHolidays           AcademicHoliday[]
  academicEvents             AcademicEvent[]
  classrooms                 Classroom[]
  classroomFeatures          ClassroomFeature[]
  classroomResources         ClassroomResource[]
  classroomMaintenances      ClassroomMaintenance[]
  classroomBookings          ClassroomBooking[]
  domainEvents               DomainEvent[]
  domainEventHandlerLogs     DomainEventHandlerLog[]
  importJobs                 ImportJob[]
  studentTimelineEvents      StudentTimelineEvent[]
  attendanceSessions         AttendanceSession[]
  attendanceRecords          AttendanceRecord[]
  attendanceJustifications   AttendanceJustification[]
  assessmentPolicies         AssessmentPolicy[]
  assessmentComponents       AssessmentComponent[]
  assessmentPeriods          AssessmentPeriod[]
  assessments                Assessment[]
  assessmentResults          AssessmentResult[]
  assessmentPublications     AssessmentPublication[]
  studentSubjectProgress     StudentSubjectProgress[]
  assessmentRetakes          AssessmentRetake[]
  studentAssessmentResults   StudentAssessmentResult[]
  gradeChangeLogs            GradeChangeLog[]
  studentLevelProgress       StudentLevelProgress[]
  studentCourseProgress      StudentCourseProgress[]
  prerequisiteGroups         LevelSubjectPrerequisiteGroup[]
  prerequisiteItems          LevelSubjectPrerequisiteItem[]
  prerequisiteWaivers        PrerequisiteWaiver[]
  levelProgressionPolicies   LevelProgressionPolicy[]
  levelProgressionRequests   LevelProgressionRequest[]
  refunds                    Refund[]
  financialTransactions      FinancialTransaction[]
  financialIntegrityIssues   FinancialIntegrityIssue[]
  financialAuditLogs         FinancialAuditLog[]
  studentDocuments           StudentDocument[]
  teacherDocuments           TeacherDocument[]
  guardianLinks              GuardianStudent[]
  attendancePolicies         AttendancePolicy[]
  subjectAttendanceSummaries StudentSubjectAttendanceSummary[]
  periodAttendanceSummaries  StudentPeriodAttendanceSummary[]
  transcriptNumberCounters   TranscriptNumberCounter[]

  @@map("organizations")
}

model Branch {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  code           String?
  address        String?
  phone          String?
  email          String?
  isDefault      Boolean   @default(false)
  // BranchStatus: ACTIVE | INACTIVE
  status         String    @default("ACTIVE")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  classGroups        ClassGroup[]
  students           Student[]
  teachers           Teacher[]
  vehicles           Vehicle[]
  enrollments        Enrollment[]
  invoices           Invoice[]
  payments           Payment[]
  receipts           Receipt[]
  classrooms         Classroom[]
  classroomBookings  ClassroomBooking[]
  attendanceSessions AttendanceSession[]
  refunds            Refund[]

  @@map("branches")
}

model OrganizationSettings {
  id                                          String   @id @default(cuid())
  organizationId                              String   @unique
  currencyCode                                String   @default("MZN")
  currencySymbol                              String   @default("MT")
  dateFormat                                  String   @default("DD/MM/YYYY")
  taxRate                                     Decimal? @db.Decimal(5, 2)
  taxName                                     String?
  invoicePrefix                               String   @default("INV")
  receiptPrefix                               String   @default("REC")
  allowLatePayments                           Boolean  @default(true)
  gracePeriodDays                             Int      @default(7)
  enableAutomaticOverdueProcessing            Boolean  @default(true)
  overdueGraceDays                            Int      @default(0)
  markInvoiceOverdueWhenAnyInstallmentOverdue Boolean  @default(true)
  notifyOnOverdue                             Boolean  @default(true)
  overdueNotificationDelayDays                Int      @default(0)
  // Student Portal provisioning policy — when an enrollment becomes ACTIVE,
  // auto-create/link a STUDENT login. studentPortalInviteStrategy: INVITE_LINK | TEMP_PASSWORD
  autoCreateStudentUserOnActivation           Boolean  @default(true)
  sendStudentPortalInvite                     Boolean  @default(true)
  studentPortalInviteStrategy                 String   @default("INVITE_LINK")
  createdAt                                   DateTime @default(now())
  updatedAt                                   DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("organization_settings")
}

// =============================================================================
// AUTHENTICATION (Auth.js / NextAuth compatible)
// =============================================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  avatarUrl     String?
  phone         String?
  passwordHash  String?
  emailVerified DateTime?
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  accounts          Account[]
  sessions          Session[]
  userOrganizations UserOrganization[]
  userRoles         UserRole[]
  notifications     Notification[]
  auditLogs         AuditLog[]         @relation("AuditActor")
  teacherProfile    Teacher?
  studentProfile    Student?
  importJobs        ImportJob[]
  guardianLinks     GuardianStudent[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.NVarChar(Max)
  access_token      String? @db.NVarChar(Max)
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.NVarChar(Max)
  session_state     String?

  // Cascade is safe here — single path User → Account
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  // Cascade is safe here — single path User → Session
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model UserOrganization {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  isOwner        Boolean  @default(false)
  joinedAt       DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([userId, organizationId])
  @@map("user_organizations")
}

// =============================================================================
// ROLES & PERMISSIONS (RBAC)
// =============================================================================

model Role {
  id             String   @id @default(cuid())
  organizationId String?
  name           String
  code           String?
  description    String?
  isSystem       Boolean  @default(false)
  // RoleStatus: ACTIVE | ARCHIVED
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization    Organization?    @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([organizationId, name])
  @@unique([organizationId, code])
  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  module      String
  action      String
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id             String   @id @default(cuid())
  userId         String
  roleId         String
  organizationId String
  branchId       String?
  assignedAt     DateTime @default(now())
  assignedBy     String?

  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  role Role @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([userId, roleId, organizationId])
  @@map("user_roles")
}

// =============================================================================
// STUDENTS
// =============================================================================

model Student {
  id             String    @id @default(cuid())
  organizationId String
  branchId       String?
  // Linked platform login (STUDENT role) — optional; enables self-service Student Portal access. Nullable: most students are managed administratively without a login.
  userId         String?   @unique
  code           String?
  firstName      String
  lastName       String
  email          String?
  phone          String?
  dateOfBirth    DateTime?
  // Gender: MALE | FEMALE | OTHER
  gender         String?
  address        String?
  photoUrl       String?
  idType         String?
  idNumber       String?
  // StudentStatus: PENDING | ACTIVE | SUSPENDED | COMPLETED | DROPPED
  status         String    @default("PENDING")
  notes          String?   @db.NVarChar(Max)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  createdBy      String?
  updatedBy      String?

  organization               Organization                      @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branch                     Branch?                           @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user                       User?                             @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  enrollments                Enrollment[]
  attendanceRecords          AttendanceRecord[]
  attendanceJustifications   AttendanceJustification[]
  practicalLessons           PracticalLesson[]
  subjectAttendanceSummaries StudentSubjectAttendanceSummary[]
  periodAttendanceSummaries  StudentPeriodAttendanceSummary[]
  invoices                   Invoice[]
  payments                   Payment[]
  receipts                   Receipt[]
  wallets                    StudentWallet[]
  lessonProgress             StudentLessonProgress[]
  timelineEvents             StudentTimelineEvent[]
  assessmentResults          AssessmentResult[]
  studentSubjectProgress     StudentSubjectProgress[]
  assessmentRetakes          AssessmentRetake[]
  studentAssessmentResults   StudentAssessmentResult[]
  studentLevelProgress       StudentLevelProgress[]
  studentCourseProgress      StudentCourseProgress[]
  prerequisiteWaivers        PrerequisiteWaiver[]
  levelProgressionRequests   LevelProgressionRequest[]
  refunds                    Refund[]
  documents                  StudentDocument[]
  guardianLinks              GuardianStudent[]

  @@index([organizationId, branchId])
  @@map("students")
}

// =============================================================================
// GUARDIAN / PARENT PORTAL
// Links a guardian/parent User (GUARDIAN role) to a Student. One guardian may
// have many students; one student may have many guardians. Per-link visibility
// flags govern what the guardian sees in the Guardian Portal. The guardian is a
// plain User (never a dedicated Guardian entity) so the same person can hold
// other roles in other orgs. The relationship is organization-scoped.
// See docs/guardian-portal.md.
// =============================================================================

model GuardianStudent {
  id                      String    @id @default(cuid())
  organizationId          String
  // The guardian's platform login (User with GUARDIAN role). NEVER the Student.userId.
  guardianUserId          String
  studentId               String
  // GuardianRelationshipType: FATHER | MOTHER | GUARDIAN | SPONSOR | OTHER
  relationshipType        String    @default("GUARDIAN")
  isPrimary               Boolean   @default(false)
  // Per-link visibility flags — enforced server-side in every Guardian Portal read.
  canViewAcademic         Boolean   @default(true)
  canViewAttendance       Boolean   @default(true)
  canViewFinance          Boolean   @default(false)
  canViewDocuments        Boolean   @default(true)
  canReceiveNotifications Boolean   @default(true)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  deletedAt               DateTime?
  createdBy               String?
  updatedBy               String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  guardian     User         @relation(fields: [guardianUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organizationId, guardianUserId])
  @@index([organizationId, studentId])
  // The unique "one active link per (org, guardian, student)" constraint is a
  // FILTERED unique index (WHERE deletedAt IS NULL), declared in the migration —
  // a plain @@unique would block re-linking after a soft-delete, and SQL Server
  // treats multiple NULLs as duplicates. See the migration for the index.
  @@map("guardian_students")
}

// =============================================================================
// TEACHERS
// =============================================================================

model Teacher {
  id             String    @id @default(cuid())
  organizationId String
  branchId       String?
  // Linked platform login (TEACHER role) — optional; enables self-service Teacher 360 access. Nullable: most teachers are managed administratively without a login.
  userId         String?   @unique
  code           String?
  firstName      String
  lastName       String
  email          String?
  phone          String?
  dateOfBirth    DateTime?
  // Gender: MALE | FEMALE | OTHER
  gender         String?
  address        String?
  photoUrl       String?
  idType         String?
  idNumber       String?
  licenseNumber  String?
  specialization String?
  hireDate       DateTime?
  // TeacherStatus: ACTIVE | INACTIVE | SUSPENDED
  status         String    @default("ACTIVE")
  notes          String?   @db.NVarChar(Max)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  createdBy      String?
  updatedBy      String?

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branch             Branch?             @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user               User?               @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  teacherSubjects    TeacherSubject[]
  classGroups        ClassGroup[]
  practicalLessons   PracticalLesson[]
  attendanceSessions AttendanceSession[]
  assessments        Assessment[]
  documents          TeacherDocument[]

  @@map("teachers")
}

model TeacherDocument {
  id             String    @id @default(cuid())
  organizationId String
  teacherId      String
  // TeacherDocumentType: CONTRACT | CV | CERTIFICATE | IDENTIFICATION | LICENSE | OTHER
  type           String
  name           String
  url            String    @db.NVarChar(Max)
  mimeType       String?
  size           Int?
  uploadedById   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  teacher      Teacher      @relation(fields: [teacherId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organizationId, teacherId])
  @@map("teacher_documents")
}

// =============================================================================
// COURSES
// =============================================================================

model CourseCategory {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  description    String?
  // CourseCategoryStatus: ACTIVE | INACTIVE | ARCHIVED
  status         String    @default("ACTIVE")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  createdBy      String?
  updatedBy      String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  courses      Course[]

  @@unique([organizationId, name])
  @@map("course_categories")
}

model Course {
  id             String    @id @default(cuid())
  organizationId String
  categoryId     String?
  name           String
  code           String?
  description    String?   @db.NVarChar(Max)
  durationWeeks  Int?
  totalHours     Int?
  price          Decimal?  @db.Decimal(10, 2)
  isActive       Boolean   @default(true)
  // CourseStatus: DRAFT | ACTIVE | INACTIVE | ARCHIVED
  status         String    @default("DRAFT")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  createdBy      String?
  updatedBy      String?

  organization              Organization                     @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  category                  CourseCategory?                  @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  levels                    CourseLevel[]
  levelSubjects             LevelSubject[]
  classGroups               ClassGroup[]
  enrollments               Enrollment[]
  studentCourseProgress     StudentCourseProgress[]
  levelProgressionPolicies  LevelProgressionPolicy[]
  levelProgressionRequests  LevelProgressionRequest[]
  periodAttendanceSummaries StudentPeriodAttendanceSummary[]

  @@map("courses")
}

model CourseLevel {
  id            String   @id @default(cuid())
  courseId      String
  name          String
  code          String?
  description   String?
  order         Int      @default(0)
  durationWeeks Int?
  totalHours    Int?
  isActive      Boolean  @default(true)
  // CourseLevelStatus: ACTIVE | INACTIVE | ARCHIVED
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  course                    Course                           @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  levelSubjects             LevelSubject[]
  classGroups               ClassGroup[]
  enrollments               Enrollment[]                     @relation("CourseLevelEnrollments")
  initialEnrollments        Enrollment[]                     @relation("InitialLevelEnrollments")
  currentEnrollments        Enrollment[]                     @relation("CurrentLevelEnrollments")
  studentLevelProgress      StudentLevelProgress[]
  fromProgressionPolicies   LevelProgressionPolicy[]         @relation("FromLevel")
  toProgressionPolicies     LevelProgressionPolicy[]         @relation("ToLevel")
  fromProgressionRequests   LevelProgressionRequest[]        @relation("FromLevelRequests")
  toProgressionRequests     LevelProgressionRequest[]        @relation("ToLevelRequests")
  periodAttendanceSummaries StudentPeriodAttendanceSummary[]

  @@map("course_levels")
}

model Subject {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  code           String?
  description    String?   @db.NVarChar(Max)
  // SubjectStatus: ACTIVE | INACTIVE | ARCHIVED
  status         String    @default("ACTIVE")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization             Organization              @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  levelSubjects            LevelSubject[]
  teacherSubjects          TeacherSubject[]
  subjectLessons           SubjectLesson[]
  attendanceSessions       AttendanceSession[]
  studentAssessmentResults StudentAssessmentResult[]

  @@unique([organizationId, code])
  @@map("subjects")
}

model LevelSubject {
  id                          String    @id @default(cuid())
  organizationId              String
  courseId                    String
  courseLevelId               String
  subjectId                   String
  order                       Int       @default(0)
  workloadHours               Int?
  theoryHours                 Int?
  practicalHours              Int?
  minimumPassingGrade         Decimal?  @db.Decimal(5, 2)
  minimumAttendancePercentage Decimal?  @db.Decimal(5, 2)
  maxAbsences                 Int?
  isRequired                  Boolean   @default(true)
  allowRetakeExam             Boolean   @default(true)
  allowCompensation           Boolean   @default(false)
  certificateRequired         Boolean   @default(false)
  credits                     Int?      @default(0)
  // Optional interpretation-policy override; null → organization default policy.
  attendancePolicyId          String?
  // LevelSubjectStatus: ACTIVE | INACTIVE | ARCHIVED
  status                      String    @default("ACTIVE")
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt
  deletedAt                   DateTime?

  organization              Organization                      @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  course                    Course                            @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  courseLevel               CourseLevel                       @relation(fields: [courseLevelId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subject                   Subject                           @relation(fields: [subjectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  attendancePolicy          AttendancePolicy?                 @relation(fields: [attendancePolicyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assessmentPolicies        AssessmentPolicy[]
  studentSubjectProgress    StudentSubjectProgress[]
  studentAssessmentResults  StudentAssessmentResult[]
  prerequisiteGroups        LevelSubjectPrerequisiteGroup[]
  prerequisiteItemsAsPrereq LevelSubjectPrerequisiteItem[]    @relation("PrerequisiteSubject")
  prerequisiteWaivers       PrerequisiteWaiver[]
  attendanceSummaries       StudentSubjectAttendanceSummary[]

  @@unique([courseLevelId, subjectId])
  @@index([organizationId, attendancePolicyId])
  @@map("level_subjects")
}

model TeacherSubject {
  id         String   @id @default(cuid())
  teacherId  String
  subjectId  String
  assignedAt DateTime @default(now())

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([teacherId, subjectId])
  @@map("teacher_subjects")
}

// =============================================================================
// CLASS GROUPS & SCHEDULES
// =============================================================================

model ClassGroup {
  id             String    @id @default(cuid())
  organizationId String
  branchId       String?
  courseId       String
  courseLevelId  String?
  teacherId      String?
  academicYearId String
  academicTermId String?
  name           String
  code           String?
  capacity       Int       @default(30)
  currentCount   Int       @default(0)
  startDate      DateTime?
  endDate        DateTime?
  // ClassGroupStatus: FORMING | ACTIVE | COMPLETED | CANCELLED
  status         String    @default("FORMING")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  createdBy      String?

  branch                    Branch?                          @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  course                    Course                           @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  courseLevel               CourseLevel?                     @relation(fields: [courseLevelId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  teacher                   Teacher?                         @relation(fields: [teacherId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  academicYear              AcademicYear                     @relation(fields: [academicYearId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  academicTerm              AcademicTerm?                    @relation(fields: [academicTermId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  classGroupSchedules       ClassGroupSchedule[]
  enrollments               Enrollment[]
  attendanceSessions        AttendanceSession[]
  classroomBookings         ClassroomBooking[]
  assessments               Assessment[]
  periodAttendanceSummaries StudentPeriodAttendanceSummary[]

  @@map("class_groups")
}

// =============================================================================
// SCHEDULE PERIODS & SLOTS
// Reusable, org-scoped schedule definitions.
// =============================================================================

model SchedulePeriod {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  code           String
  description    String?
  // ScheduleStatus: ACTIVE | INACTIVE | ARCHIVED
  status         String    @default("ACTIVE")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  slots        ScheduleSlot[]

