// =============================================================================
// FINANCIAL TRANSACTION LEDGER (append-only)
// =============================================================================
// CRITICAL: This model is IMMUTABLE. Never update or delete rows.
// Every financial movement produces one or more journal entries here.
// Used as the source of truth for reconciliation and cash-flow reports.

model FinancialTransaction {
  id                String   @id @default(cuid())
  organizationId    String
  transactionNumber String
  // FinancialTransactionType:
  //   INVOICE_CREATED | INVOICE_CANCELLED |
  //   PAYMENT_RECEIVED | PAYMENT_CANCELLED |
  //   CREDIT_APPLIED |
  //   WALLET_CREDIT | WALLET_DEBIT |
  //   REFUND_DISBURSED | RECEIPT_ISSUED
  transactionType   String
  // FinancialDirection: CREDIT | DEBIT  (from organization's perspective)
  direction         String
  amount            Decimal  @db.Decimal(10, 2)
  currencyCode      String   @default("MZN")
  // sourceType: "Invoice" | "Payment" | "Receipt" | "Refund" |
  //             "WalletTransaction" | "CreditApplication"
  sourceType        String
  sourceId          String
  // Cross-references for reconciliation queries
  invoiceId         String?
  paymentId         String?
  receiptId         String?
  refundId          String?
  studentId         String?
  enrollmentId      String?
  description       String?  @db.NVarChar(Max)
  actorId           String?
  occurredAt        DateTime @default(now())
  createdAt         DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([organizationId, transactionNumber])
  @@index([organizationId, invoiceId])
  @@index([organizationId, paymentId])
  @@index([organizationId, studentId])
  @@index([organizationId, occurredAt])
  @@index([organizationId, transactionType])
  @@index([organizationId, transactionType, occurredAt], name: "financial_tx_org_type_occurredat_idx")
  @@index([organizationId, sourceType, sourceId], name: "financial_tx_org_source_ref_idx")
  @@index([organizationId, studentId, occurredAt], name: "financial_tx_org_student_occurredat_idx")
  @@map("financial_transactions")
}

// =============================================================================
// FINANCIAL INTEGRITY ISSUES
// =============================================================================
// Populated by the daily integrity-check job. Never auto-repaired — only
// detected and recorded. Resolved by a human operator via the admin UI.

model FinancialIntegrityIssue {
  id              String    @id @default(cuid())
  organizationId  String
  // IntegrityIssueSeverity: CRITICAL | HIGH | MEDIUM | LOW
  severity        String
  // IntegrityIssueCategory: INVOICE_BALANCE | INSTALLMENT_BALANCE |
  //   PAYMENT_ALLOCATION | WALLET_BALANCE | REFUND_TOTAL |
  //   RECEIPT_INTEGRITY | ORPHAN_RECORD | LEDGER_CONSISTENCY
  category        String
  // Machine-readable check identifier e.g. "invoice.balance_amounts"
  checkName       String
  // Domain entity type e.g. "Invoice", "Payment", "Receipt", "Refund"
  entityType      String
  entityId        String
  description     String    @db.NVarChar(Max)
  expectedValue   String?
  actualValue     String?
  detectedAt      DateTime  @default(now())
  jobRunId        String?
  // IntegrityIssueStatus: OPEN | ACKNOWLEDGED | RESOLVED | SUPPRESSED
  status          String    @default("OPEN")
  resolvedAt      DateTime?
  resolvedBy      String?
  resolutionNotes String?   @db.NVarChar(Max)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // No @@unique here: deduplication of OPEN issues is enforced by the
  // filtered unique index in migration SQL (WHERE status = 'OPEN').
  @@index([organizationId, severity])
  @@index([organizationId, category])
  @@index([organizationId, status, detectedAt])
  @@index([organizationId, entityType, entityId])
  @@index([organizationId, status, severity], name: "fii_org_status_severity_idx")
  @@index([organizationId, category, status], name: "fii_org_category_status_idx")
  @@map("financial_integrity_issues")
}

// =============================================================================
// FINANCIAL AUDIT LOG
