  taxAmount       Decimal   @default(0) @db.Decimal(10, 2)
  totalAmount     Decimal   @db.Decimal(10, 2)
  paidAmount      Decimal   @default(0) @db.Decimal(10, 2)
  balanceAmount   Decimal   @default(0) @db.Decimal(10, 2)
  // InvoiceStatus: PENDING | PARTIALLY_PAID | PAID | OVERDUE | CANCELLED
  status          String    @default("PENDING")
  notes           String?   @db.NVarChar(Max)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  createdBy       String?
  updatedBy       String?

  organization     Organization             @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branch           Branch?                  @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student          Student?                 @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  enrollment       Enrollment?              @relation(fields: [enrollmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  billingPolicy    EnrollmentBillingPolicy? @relation(fields: [billingPolicyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  items            InvoiceItem[]
  payments         Payment[]
  paymentPlan      PaymentPlan?
  receipts         Receipt[]
  allocations      PaymentAllocation[]
  appliedDiscounts AppliedDiscount[]
  appliedTaxes     AppliedTax[]
  refunds          Refund[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, studentId, status], name: "invoices_org_student_status_idx")
  @@index([organizationId, status, dueDate], name: "invoices_org_status_duedate_idx")
  @@index([organizationId, status, issueDate], name: "invoices_org_status_issuedate_idx")
  @@index([organizationId, branchId, status, issueDate], name: "invoices_org_branch_status_issuedate_idx")
  @@index([organizationId, enrollmentId, status], name: "invoices_org_enrollment_status_idx")
  @@map("invoices")
}

model InvoiceItem {
  id              String   @id @default(cuid())
  organizationId  String
  invoiceId       String
  feeDefinitionId String?
  // InvoiceItemType: REGISTRATION_FEE | COURSE_FEE | MATERIAL_FEE | EXAM_FEE | CERTIFICATE_FEE | PENALTY | OTHER
  itemType        String   @default("OTHER")
  description     String
  quantity        Decimal  @default(1) @db.Decimal(10, 2)
  unitPrice       Decimal  @db.Decimal(10, 2)
  totalPrice      Decimal  @db.Decimal(10, 2)
  paidAmount      Decimal  @default(0) @db.Decimal(10, 2)
  balanceAmount   Decimal  @default(0) @db.Decimal(10, 2)
  priority        Int      @default(7)
  // InvoiceItemStatus: PENDING | PARTIALLY_PAID | PAID
  status          String   @default("PENDING")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Cascade is safe here — Invoice is the single owner of its items
  invoice     Invoice             @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  allocations PaymentAllocation[]

  @@map("invoice_items")
}

model PaymentPlan {
  id                   String   @id @default(cuid())
  organizationId       String
  invoiceId            String   @unique
  name                 String
  numberOfInstallments Int
  totalAmount          Decimal  @db.Decimal(10, 2)
  // PaymentPlanStatus: ACTIVE | COMPLETED | CANCELLED
  status               String   @default("ACTIVE")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  invoice         Invoice       @relation(fields: [invoiceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  installmentList Installment[]

  @@map("payment_plans")
}

model Installment {
  id                String    @id @default(cuid())
  organizationId    String
  paymentPlanId     String
  invoiceId         String
  installmentNumber Int
  dueDate           DateTime
  amount            Decimal   @db.Decimal(10, 2)
  paidAmount        Decimal   @default(0) @db.Decimal(10, 2)
  balanceAmount     Decimal   @default(0) @db.Decimal(10, 2)
  // InstallmentStatus: PENDING | PARTIALLY_PAID | PAID | OVERDUE
  status            String    @default("PENDING")
  paidAt            DateTime?

  paymentPlan PaymentPlan @relation(fields: [paymentPlanId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payments    Payment[]

  @@index([organizationId, status, dueDate], name: "installments_org_status_duedate_idx")
  @@index([organizationId, invoiceId, status], name: "installments_org_invoice_status_idx")
  @@map("installments")
}

model Payment {
  id             String   @id @default(cuid())
  organizationId String
  branchId       String?
  invoiceId      String?
  installmentId  String?
  studentId      String?
  enrollmentId   String?
  paymentNumber  String
  paymentDate    DateTime @default(now())
  totalAmount    Decimal  @db.Decimal(10, 2)
  // PaymentStatus: PENDING | CONFIRMED | CANCELLED | REFUNDED
  status         String   @default("PENDING")
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      String?

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branch             Branch?             @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student            Student?            @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  invoice            Invoice?            @relation(fields: [invoiceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  installment        Installment?        @relation(fields: [installmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  enrollment         Enrollment?         @relation(fields: [enrollmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  receipt            Receipt?
  splits             PaymentSplit[]
  creditApplications CreditApplication[]
  allocations        PaymentAllocation[]
  refunds            Refund[]

  @@unique([organizationId, paymentNumber])
  @@index([organizationId, status, paymentDate], name: "payments_org_status_paymentdate_idx")
  @@index([organizationId, branchId, status, paymentDate], name: "payments_org_branch_status_paymentdate_idx")
  @@index([organizationId, invoiceId, status], name: "payments_org_invoice_status_idx")
  @@map("payments")
}

model Receipt {
  id                 String    @id @default(cuid())
  organizationId     String
  branchId           String?
  paymentId          String    @unique
  invoiceId          String
  studentId          String?
  receiptNumber      String
  issueDate          DateTime  @default(now())
  amount             Decimal   @db.Decimal(10, 2)
  refundedAmount     Decimal   @default(0) @db.Decimal(10, 2)
  // ReceiptStatus: ISSUED | PARTIALLY_REFUNDED | CANCELLED
  status             String    @default("ISSUED")
  issuedBy           String?
  cancelledAt        DateTime?
  cancelledBy        String?
  cancellationReason String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payment      Payment      @relation(fields: [paymentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student      Student?     @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  refunds      Refund[]

  @@unique([organizationId, receiptNumber])
  @@map("receipts")
}

model PaymentSplit {
  id             String   @id @default(cuid())
  organizationId String
  paymentId      String
  // PaymentMethod: CASH | BANK_TRANSFER | MPESA | EMOLA | POS | CARD | CHEQUE | OTHER
  method         String
  amount         Decimal  @db.Decimal(15, 2)
  reference      String?
  notes          String?  @db.NVarChar(Max)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payment      Payment      @relation(fields: [paymentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organizationId, method, createdAt], name: "payment_splits_org_method_createdat_idx")
  @@index([paymentId, method], name: "payment_splits_payment_method_idx")
  @@map("payment_splits")
}

model PaymentAllocation {
  id                  String   @id @default(cuid())
  organizationId      String
  paymentId           String?
  creditApplicationId String?
  invoiceId           String
  invoiceItemId       String
  amount              Decimal  @db.Decimal(10, 2)
  // AllocationType: PAYMENT | WALLET_CREDIT | ADJUSTMENT | REFUND_REVERSAL
  allocationType      String   @default("PAYMENT")
  createdAt           DateTime @default(now())
  createdBy           String?

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payment           Payment?           @relation(fields: [paymentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  creditApplication CreditApplication? @relation(fields: [creditApplicationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  invoice           Invoice            @relation(fields: [invoiceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  invoiceItem       InvoiceItem        @relation(fields: [invoiceItemId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // Reconciliation Report: SUM(amount) GROUP BY invoiceId vs Invoice.paidAmount
  @@index([organizationId, invoiceId], name: "payment_allocations_org_invoice_idx")
  @@map("payment_allocations")
}

// =============================================================================
// STUDENT WALLET
// =============================================================================

model StudentWallet {
  id             String   @id @default(cuid())
  organizationId String
  studentId      String
  // WalletStatus: ACTIVE | SUSPENDED
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      String?

  organization       Organization               @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student            Student                    @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  transactions       StudentWalletTransaction[]
  creditApplications CreditApplication[]

  @@unique([organizationId, studentId])
  @@map("student_wallets")
}

model StudentWalletTransaction {
  id              String   @id @default(cuid())
  organizationId  String
  studentWalletId String
  // WalletTransactionType: DEPOSIT | OVERPAYMENT | CREDIT_APPLIED | REFUND | ADJUSTMENT | PROMOTIONAL_CREDIT
  type            String
  // Signed: positive = credit to wallet; negative = debit from wallet
  amount          Decimal  @db.Decimal(15, 2)
  referenceType   String?
  referenceId     String?
  description     String?  @db.NVarChar(Max)
  createdAt       DateTime @default(now())
  createdBy       String?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  wallet       StudentWallet @relation(fields: [studentWalletId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([studentWalletId, createdAt])
  @@index([organizationId, type, createdAt])
  @@index([organizationId, createdAt], name: "swt_org_createdat_idx")
  @@map("student_wallet_transactions")
}

model CreditApplication {
  id              String   @id @default(cuid())
  organizationId  String
  studentId       String
  studentWalletId String
  invoiceId       String
  // Optional link to a Payment when credit is applied as part of a payment transaction
  paymentId       String?
  amount          Decimal  @db.Decimal(15, 2)
  notes           String?  @db.NVarChar(Max)
  createdAt       DateTime @default(now())
  createdBy       String?

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  wallet       StudentWallet       @relation(fields: [studentWalletId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payment      Payment?            @relation(fields: [paymentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  allocations  PaymentAllocation[]

  @@map("credit_applications")
}

// =============================================================================
// NOTIFICATIONS
// =============================================================================

model Notification {
  id              String    @id @default(cuid())
  organizationId  String
  recipientUserId String
  // NotificationType: see src/shared/types/common.ts NotificationType
  type            String
  // NotificationSeverity: INFO | SUCCESS | WARNING | CRITICAL
  severity        String    @default("INFO")
  title           String
  message         String    @db.NVarChar(Max)
  // NotificationStatus: UNREAD | READ | ARCHIVED
  status          String    @default("UNREAD")
  actionUrl       String?
  metadata        String?   @db.NVarChar(Max)
  readAt          DateTime?
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  recipient    User                   @relation(fields: [recipientUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  deliveries   NotificationDelivery[]

  @@index([organizationId, recipientUserId, status, createdAt])
  @@index([organizationId, type, createdAt])
  @@map("notifications")
}

// =============================================================================
// NOTIFICATIONS CENTER — PHASE 3.1: DELIVERY INFRASTRUCTURE
// Tracks one delivery attempt per (Notification, channel). IN_APP rows are
// created already DELIVERED — the Notification row itself *is* the delivery.
// Other channels (EMAIL/WHATSAPP/SMS/PUSH) get PENDING/FAILED rows with no
// real provider behind them yet — see docs/notifications-center.md.
// =============================================================================

model NotificationDelivery {
  id             String @id @default(cuid())
  organizationId String
  notificationId String

  // NotificationChannel: IN_APP | EMAIL | WHATSAPP | SMS | PUSH
  channel   String
  recipient String

  // NotificationDeliveryStatus: PENDING | PROCESSING | SENT | DELIVERED | FAILED | CANCELLED
  status String @default("PENDING")

  // Reserved for the real provider integration (Phase 3.2) — e.g. "resend", "twilio".
  provider          String?
  providerMessageId String?

  attempts    Int @default(0)
  maxAttempts Int @default(3)

  lastAttemptAt DateTime?
  nextAttemptAt DateTime?

  sentAt      DateTime?
  deliveredAt DateTime?
  failedAt    DateTime?
  cancelledAt DateTime?

  failureReason String? @db.NVarChar(Max)
  metadata      String? @db.NVarChar(Max)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organizationId, status, channel, createdAt])
  @@index([notificationId])
  @@index([organizationId, nextAttemptAt, status])
  @@index([organizationId, channel, createdAt])
  @@map("notification_deliveries")
}

// =============================================================================
// NOTIFICATIONS CENTER — PHASE 3.2B: EMAIL SETTINGS
// One row per organization. SMTP credentials are stored encrypted
// (smtpPasswordEncrypted) — see src/shared/lib/secret-encryption.ts. The
// Microsoft Graph fields are reserved for a future provider and are never
// read by anything yet (see docs/notifications-center.md).
// =============================================================================

model NotificationEmailSettings {
  id             String @id @default(cuid())
  organizationId String @unique

  // NotificationEmailProviderType: SMTP | MICROSOFT_GRAPH
  providerType String  @default("SMTP")
  isEnabled    Boolean @default(false)

  fromName  String
  fromEmail String
  replyTo   String?

  smtpHost              String?
  smtpPort              Int?
  smtpUsername          String?
  smtpPasswordEncrypted String? @db.NVarChar(Max)
  smtpSecure            Boolean @default(true)

  // Reserved — Microsoft Graph is not implemented in this phase.
  graphTenantId              String?
  graphClientId              String?
  graphClientSecretEncrypted String? @db.NVarChar(Max)

  lastTestedAt   DateTime?
  // NotificationEmailTestStatus: SUCCESS | FAILED
  lastTestStatus String?
  lastTestError  String?   @db.NVarChar(Max)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("notification_email_settings")
}

// =============================================================================
// NOTIFICATIONS CENTER — PHASE 2: TEMPLATES & EVENT RULES
// =============================================================================

model NotificationTemplate {
  id             String    @id @default(cuid())
  organizationId String
  // eventType matches DomainEventType (e.g. "payment.confirmed") — see
  // src/modules/notifications/catalog/notification-event-catalog.ts
  eventType      String
  // NotificationChannel: IN_APP | EMAIL | WHATSAPP | SMS — Phase 2 only resolves IN_APP
  channel        String    @default("IN_APP")
  name           String
  // Future EMAIL channel subject line — unused for IN_APP
  subject        String?
  titleTemplate  String    @db.NVarChar(Max)
  bodyTemplate   String    @db.NVarChar(Max)
  // Variable names referenced by titleTemplate/bodyTemplate, extracted at save time
  variables      String    @db.NVarChar(Max)
  language       String    @default("pt-PT")
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organizationId, eventType, channel])
  @@index([organizationId, isActive])
  @@map("notification_templates")
}

model NotificationEventRule {
  id                  String    @id @default(cuid())
  organizationId      String
  // eventType matches DomainEventType (e.g. "payment.confirmed")
  eventType           String
  enabled             Boolean   @default(true)
  // JSON-encoded NotificationChannel[] — e.g. ["IN_APP"]
  channels            String    @db.NVarChar(Max)
  dedupeWindowMinutes Int       @default(1440)
  // Stored for a future dispatcher — not acted upon in Phase 2
  delayMinutes        Int       @default(0)
  // NotificationRulePriority: LOW | NORMAL | HIGH | CRITICAL
  priority            String    @default("NORMAL")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([organizationId, eventType])
  @@index([organizationId, eventType])
  @@index([organizationId, enabled])
  @@map("notification_event_rules")
}

// =============================================================================
// LESSONS & CONTENT LIBRARY
// =============================================================================

model Lesson {
  id              String    @id @default(cuid())
  organizationId  String
  title           String
  slug            String
  description     String?   @db.NVarChar(Max)
  summary         String?   @db.NVarChar(Max)
  objectives      String?   @db.NVarChar(Max)
  durationMinutes Int?
  // LessonType: VIDEO | TEXT | LIVE | PRACTICAL | READING | ASSIGNMENT_PREP
  lessonType      String    @default("TEXT")
  // VideoProvider: YOUTUBE | VIMEO | CLOUDFLARE_STREAM | BUNNY | S3 | EXTERNAL | NONE
  videoProvider   String    @default("NONE")
  videoUrl        String?   @db.NVarChar(Max)
  externalVideoId String?
  thumbnailUrl    String?   @db.NVarChar(Max)
  // LessonStatus: DRAFT | PUBLISHED | ARCHIVED
  status          String    @default("DRAFT")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  attachments    LessonAttachment[]
  subjectLessons SubjectLesson[]
  lessonProgress StudentLessonProgress[]

  @@unique([organizationId, slug])
  @@map("lessons")
}

model LessonAttachment {
  id             String    @id @default(cuid())
  organizationId String
  lessonId       String
  fileName       String
  fileUrl        String    @db.NVarChar(Max)
  // FileType: PDF | IMAGE | DOCUMENT | SPREADSHEET | PRESENTATION | AUDIO | VIDEO | OTHER
  fileType       String    @default("OTHER")
  fileSize       Int?
  isDownloadable Boolean   @default(true)
  // LessonAttachmentStatus: ACTIVE | ARCHIVED
  status         String    @default("ACTIVE")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lesson       Lesson       @relation(fields: [lessonId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("lesson_attachments")
}

model SubjectLesson {
  id                  String    @id @default(cuid())
  organizationId      String
  subjectId           String
  lessonId            String
  order               Int       @default(0)
  isRequired          Boolean   @default(false)
  minWatchPercentage  Int       @default(0)
  unlockAfterLessonId String?
  // SubjectLessonStatus: ACTIVE | INACTIVE | ARCHIVED
  status              String    @default("ACTIVE")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subject        Subject                 @relation(fields: [subjectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lesson         Lesson                  @relation(fields: [lessonId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  unlockAfter    SubjectLesson?          @relation("UnlockChain", fields: [unlockAfterLessonId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  unlockedBy     SubjectLesson[]         @relation("UnlockChain")
  lessonProgress StudentLessonProgress[]

  @@unique([subjectId, lessonId])
  @@unique([subjectId, order])
  @@map("subject_lessons")
}

model StudentLessonProgress {
  id                 String    @id @default(cuid())
  organizationId     String
  studentId          String
  enrollmentId       String
  subjectId          String
  lessonId           String
  subjectLessonId    String?
  watchedSeconds     Int       @default(0)
  progressPercentage Decimal   @default(0) @db.Decimal(5, 2)
  // ProgressStatus: NOT_STARTED | IN_PROGRESS | COMPLETED
  status             String    @default("NOT_STARTED")
  completedAt        DateTime?
  lastAccessedAt     DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student       Student        @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  enrollment    Enrollment     @relation(fields: [enrollmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lesson        Lesson         @relation(fields: [lessonId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subjectLesson SubjectLesson? @relation(fields: [subjectLessonId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([studentId, enrollmentId, lessonId])
  @@map("student_lesson_progress")
}

