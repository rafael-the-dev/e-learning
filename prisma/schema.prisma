model AcademicTerm {
  id             String    @id @default(cuid())
  organizationId String
  academicYearId String
  name           String
  code           String
  startDate      DateTime
  endDate        DateTime
  order          Int
  // AcademicTermStatus: DRAFT | ACTIVE | COMPLETED | CANCELLED | ARCHIVED
  status         String    @default("DRAFT")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization              Organization                     @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  academicYear              AcademicYear                     @relation(fields: [academicYearId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  events                    AcademicEvent[]
  classGroups               ClassGroup[]
  enrollments               Enrollment[]
  classroomBookings         ClassroomBooking[]
  attendanceSessions        AttendanceSession[]
  assessmentPeriods         AssessmentPeriod[]
  assessments               Assessment[]
  periodAttendanceSummaries StudentPeriodAttendanceSummary[]

  @@unique([academicYearId, order])
  @@unique([academicYearId, code])
  @@index([organizationId, academicYearId])
  @@map("academic_terms")
}

model AcademicHoliday {
  id             String    @id @default(cuid())
  organizationId String
  academicYearId String?
  name           String
  description    String?   @db.NVarChar(Max)
  startDate      DateTime
  endDate        DateTime
  isRecurring    Boolean   @default(false)
  // AcademicHolidayStatus: DRAFT | ACTIVE | COMPLETED | CANCELLED | ARCHIVED
  status         String    @default("ACTIVE")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organizationId, academicYearId])
  @@map("academic_holidays")
}

model AcademicEvent {
  id             String    @id @default(cuid())
  organizationId String
  academicYearId String?
  academicTermId String?
  title          String
  description    String?   @db.NVarChar(Max)
  // AcademicEventType: GENERAL | EXAM_PERIOD | ENROLLMENT_PERIOD | PAYMENT_DEADLINE | HOLIDAY | TEACHER_MEETING | GRADUATION | OTHER
  eventType      String    @default("GENERAL")
  startDate      DateTime
  endDate        DateTime
  // AcademicEventStatus: DRAFT | ACTIVE | COMPLETED | CANCELLED | ARCHIVED
  status         String    @default("DRAFT")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  academicTerm AcademicTerm? @relation(fields: [academicTermId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organizationId, academicYearId])
  @@index([organizationId, eventType])
  @@map("academic_events")
}

// =============================================================================
// CLASSROOM MANAGEMENT
// =============================================================================

model Classroom {
  id             String  @id @default(cuid())
  organizationId String
  branchId       String?

  code        String
  name        String
  description String? @db.NVarChar(Max)

  // ClassroomType: STANDARD_ROOM | COMPUTER_LAB | LANGUAGE_LAB | DESIGN_STUDIO |
  //                DRIVING_ROOM | MEETING_ROOM | ONLINE_ROOM | OTHER
  classroomType String @default("STANDARD_ROOM")
  capacity      Int    @default(1)

  location String?
  floor    String?

  // MeetingProvider: ZOOM | GOOGLE_MEET | MICROSOFT_TEAMS | CUSTOM
  meetingProvider String?
  meetingUrl      String? @db.NVarChar(Max)

  // ClassroomStatus: ACTIVE | MAINTENANCE | INACTIVE | ARCHIVED
  status String @default("ACTIVE")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization       Organization           @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branch             Branch?                @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  features           ClassroomFeature[]
  resources          ClassroomResource[]
  maintenances       ClassroomMaintenance[]
  bookings           ClassroomBooking[]
  attendanceSessions AttendanceSession[]

  @@index([organizationId, branchId, code])
  @@index([organizationId, status])
  @@map("classrooms")
}

model ClassroomFeature {
  id             String @id @default(cuid())
  organizationId String
  classroomId    String

  // ClassroomFeatureType: AIR_CONDITIONING | INTERNET | PROJECTOR | SMART_BOARD |
  //                       RECORDING | ACCESSIBLE | SOUND_SYSTEM | CCTV | GENERATOR | OTHER
  feature String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  classroom    Classroom    @relation(fields: [classroomId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([classroomId, feature])
  @@map("classroom_features")
}

model ClassroomResource {
  id             String @id @default(cuid())
  organizationId String
  classroomId    String

  name        String
  quantity    Int     @default(0)
  description String?

  // ClassroomResourceStatus: ACTIVE | INACTIVE | ARCHIVED
  status String @default("ACTIVE")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  classroom    Classroom    @relation(fields: [classroomId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("classroom_resources")
}

model ClassroomMaintenance {
  id             String @id @default(cuid())
  organizationId String
  classroomId    String

  title       String
  description String?  @db.NVarChar(Max)
  startDate   DateTime
  endDate     DateTime

  // ClassroomMaintenanceStatus: SCHEDULED | IN_PROGRESS | COMPLETED | CANCELLED
  status String @default("SCHEDULED")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  classroom    Classroom    @relation(fields: [classroomId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organizationId, classroomId, status])
  @@map("classroom_maintenances")
}

model ClassroomBooking {
  id             String  @id @default(cuid())
  organizationId String
  branchId       String?

  classroomId    String
  classGroupId   String?
  scheduleSlotId String?

  academicYearId String
  academicTermId String?

  startDate DateTime
  endDate   DateTime

  // ClassroomBookingStatus: ACTIVE | COMPLETED | CANCELLED | ARCHIVED
  status String @default("ACTIVE")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branch       Branch?       @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  classroom    Classroom     @relation(fields: [classroomId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  classGroup   ClassGroup?   @relation(fields: [classGroupId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  scheduleSlot ScheduleSlot? @relation(fields: [scheduleSlotId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  academicYear AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  academicTerm AcademicTerm? @relation(fields: [academicTermId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organizationId, classroomId, status])
  @@index([organizationId, academicYearId])
  @@map("classroom_bookings")
}

// =============================================================================
// STUDENT TIMELINE
// =============================================================================

model StudentTimelineEvent {
  id             String @id @default(cuid())
  organizationId String
  studentId      String

  // TimelineEventType: ENROLLMENT_CREATED | ENROLLMENT_ACTIVATED | ENROLLMENT_CANCELLED |
  //   INVOICE_CREATED | INVOICE_PAID | PAYMENT_CONFIRMED | RECEIPT_ISSUED |
  //   WALLET_DEPOSIT_CREATED | WALLET_CREDIT_APPLIED | WALLET_OVERPAYMENT_CREATED |
  //   LESSON_COMPLETED | CLASS_GROUP_ASSIGNED | CLASSROOM_BOOKING_CHANGED |
  //   NOTIFICATION_SENT | MANUAL_NOTE
  eventType String

  title       String
  description String? @db.NVarChar(Max)

  // TimelineReferenceType: ENROLLMENT | INVOICE | PAYMENT | RECEIPT | WALLET |
  //   LESSON | CLASS_GROUP | CLASSROOM_BOOKING | NOTIFICATION | USER | SYSTEM
  referenceType String?
  referenceId   String?

  sourceEventId String? // DomainEvent.id — used for idempotency
  actorUserId   String?

  // TimelineVisibility: INTERNAL | STUDENT_VISIBLE
  visibility String @default("INTERNAL")

  metadata String? @db.NVarChar(Max)

  occurredAt DateTime
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organizationId, studentId, occurredAt])
  @@index([organizationId, studentId, eventType])
  @@index([sourceEventId])
  @@index([organizationId, occurredAt], name: "student_timeline_events_org_occurredat_idx")
  @@map("student_timeline_events")
}

// =============================================================================
// DOMAIN EVENTS
// =============================================================================

model DomainEvent {
  id             String    @id @default(cuid())
  organizationId String
  eventType      String
  aggregateType  String
  aggregateId    String
  payload        String    @db.NVarChar(Max)
  // DomainEventStatus: PENDING | PROCESSING | PROCESSED | FAILED | CANCELLED
  status         String    @default("PENDING")
  occurredAt     DateTime  @default(now())
  processedAt    DateTime?
  failedAt       DateTime?
  failureReason  String?   @db.NVarChar(Max)
  retryCount     Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  handlerLogs  DomainEventHandlerLog[]

  @@index([organizationId, eventType, status])
  @@index([organizationId, aggregateType, aggregateId])
  @@index([organizationId, status, occurredAt])
  @@map("domain_events")
}

model DomainEventHandlerLog {
  id             String    @id @default(cuid())
  organizationId String
  eventId        String
  handlerName    String
  // DomainEventHandlerStatus: PENDING | PROCESSING | PROCESSED | FAILED | SKIPPED
  status         String    @default("PENDING")
  startedAt      DateTime?
  completedAt    DateTime?
  failedAt       DateTime?
  failureReason  String?   @db.NVarChar(Max)
  retryCount     Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  event        DomainEvent  @relation(fields: [eventId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([eventId, handlerName])
  @@index([organizationId, eventId])
  @@index([organizationId, handlerName, status])
  @@map("domain_event_handler_logs")
}

// =============================================================================
// IMPORT JOBS
// =============================================================================

model ImportJob {
  id                String    @id @default(cuid())
  organizationId    String
  // ImportJobType: STUDENTS | TEACHERS | ENROLLMENTS | CLASS_GROUPS | COURSES | SUBJECTS
  type              String    @default("STUDENTS")
  // ImportJobStatus: PENDING | VALIDATED | PROCESSING | COMPLETED | FAILED
  status            String    @default("PENDING")
  uploadedFileName  String
  totalRows         Int       @default(0)
  successRows       Int       @default(0)
  failedRows        Int       @default(0)
  rowsData          String?   @db.NVarChar(Max)
  resultData        String?   @db.NVarChar(Max)
  validationSummary String?   @db.NVarChar(Max)
  executionSummary  String?   @db.NVarChar(Max)
  startedAt         DateTime?
  completedAt       DateTime?
  uploadedById      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  uploadedBy   User?        @relation(fields: [uploadedById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@map("import_jobs")
}

// =============================================================================
// ASSESSMENTS
// =============================================================================

model AssessmentPolicy {
  id                  String    @id @default(cuid())
  organizationId      String
  levelSubjectId      String
  name                String
  description         String?   @db.NVarChar(Max)
  // CalculationMethod: WEIGHTED_AVERAGE | SIMPLE_AVERAGE
  calculationMethod   String    @default("WEIGHTED_AVERAGE")
  // RoundingMethod: NONE | NEAREST_INTEGER | ONE_DECIMAL | TWO_DECIMALS
  roundingMethod      String    @default("NONE")
  minimumPassingGrade Decimal   @db.Decimal(5, 2)
  allowRetake         Boolean   @default(true)
  maxRetakes          Int       @default(1)
  allowRecovery       Boolean   @default(false)
  // AssessmentPolicyStatus: ACTIVE | INACTIVE | ARCHIVED
  status              String    @default("ACTIVE")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  levelSubject LevelSubject          @relation(fields: [levelSubjectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  components   AssessmentComponent[]
  assessments  Assessment[]

  @@index([organizationId, levelSubjectId, status])
  @@map("assessment_policies")
}

model AssessmentComponent {
  id                 String    @id @default(cuid())
  organizationId     String
  assessmentPolicyId String
  name               String
  // ComponentType: TEST | QUIZ | EXAM | ASSIGNMENT | PROJECT | ORAL | PRACTICAL | PARTICIPATION | FINAL_EXAM | RECOVERY | OTHER
  componentType      String    @default("TEST")
  weight             Decimal   @db.Decimal(5, 2)
  maxGrade           Decimal   @default(20) @db.Decimal(5, 2)
  order              Int       @default(0)
  isRequired         Boolean   @default(true)
  // AssessmentComponentStatus: ACTIVE | INACTIVE | ARCHIVED
  status             String    @default("ACTIVE")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  organization     Organization              @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assessmentPolicy AssessmentPolicy          @relation(fields: [assessmentPolicyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assessments      Assessment[]
  gradeResults     StudentAssessmentResult[]

  @@index([organizationId, assessmentPolicyId, status])
  @@map("assessment_components")
}

model AssessmentPeriod {
  id             String    @id @default(cuid())
  organizationId String
  academicYearId String
  academicTermId String?
  name           String
  code           String
  startDate      DateTime
  endDate        DateTime
  order          Int       @default(0)
  // AssessmentPeriodStatus: ACTIVE | INACTIVE | ARCHIVED
  status         String    @default("ACTIVE")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  academicYear AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  academicTerm AcademicTerm? @relation(fields: [academicTermId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assessments  Assessment[]

  @@unique([organizationId, code])
  @@index([organizationId, academicYearId, status])
  @@map("assessment_periods")
}

model Assessment {
  id                    String    @id @default(cuid())
  organizationId        String
  assessmentPolicyId    String
  assessmentComponentId String
  assessmentPeriodId    String
  academicYearId        String
  academicTermId        String?
  classGroupId          String
  courseId              String
  courseLevelId         String
  levelSubjectId        String
  subjectId             String
  teacherId             String?
  title                 String
  description           String?   @db.NVarChar(Max)
  assessmentDate        DateTime
  maxScore              Decimal   @db.Decimal(5, 2)
  // AssessmentStatus: DRAFT | SCHEDULED | OPEN | GRADED | CANCELLED | ARCHIVED
  status                String    @default("DRAFT")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?
  createdBy             String?

  organization        Organization              @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assessmentPolicy    AssessmentPolicy          @relation(fields: [assessmentPolicyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assessmentComponent AssessmentComponent       @relation(fields: [assessmentComponentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assessmentPeriod    AssessmentPeriod          @relation(fields: [assessmentPeriodId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  academicYear        AcademicYear              @relation(fields: [academicYearId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  academicTerm        AcademicTerm?             @relation(fields: [academicTermId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  classGroup          ClassGroup                @relation(fields: [classGroupId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  teacher             Teacher?                  @relation(fields: [teacherId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  results             AssessmentResult[]
  publication         AssessmentPublication?
  retakes             AssessmentRetake[]
  gradeResults        StudentAssessmentResult[]

  @@index([organizationId, classGroupId, status])
  @@index([organizationId, assessmentPeriodId])
  @@index([organizationId, levelSubjectId])
  @@map("assessments")
}

model AssessmentResult {
  id              String    @id @default(cuid())
  organizationId  String
  assessmentId    String
  studentId       String
  enrollmentId    String?
  // DEPRECATED (2026-07-01): grade values are NOT stored here anymore.
  // StudentAssessmentResult is the single source of truth for grades.
  // AssessmentResult is a participation/event sidecar (status + feedback) only.
  // These columns are always written null and never read by the grade engine.
  // Kept for backward compatibility; do not populate or read for calculations.
  score           Decimal?  @db.Decimal(5, 2)
  normalizedScore Decimal?  @db.Decimal(5, 2)
  feedback        String?   @db.NVarChar(Max)
  // AssessmentResultStatus: PENDING | SUBMITTED | GRADED | MISSING | EXCUSED | INVALIDATED
  status          String    @default("PENDING")
  gradedByUserId  String?
  gradedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assessment   Assessment         @relation(fields: [assessmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student      Student            @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  enrollment   Enrollment?        @relation(fields: [enrollmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  retakes      AssessmentRetake[]

  @@unique([assessmentId, studentId])
  @@index([organizationId, studentId])
  @@index([organizationId, assessmentId, status])
  @@index([organizationId, status, gradedAt], name: "assessment_results_org_status_gradedat_idx")
  @@map("assessment_results")
}

model AssessmentPublication {
  id                String    @id @default(cuid())
  organizationId    String
  assessmentId      String    @unique
  // PublicationStatus: DRAFT | READY | PUBLISHED | ARCHIVED
  publicationStatus String    @default("DRAFT")
  publishedAt       DateTime?
  publishedByUserId String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assessment   Assessment   @relation(fields: [assessmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organizationId, publicationStatus])
  @@map("assessment_publications")
}

model StudentSubjectProgress {
  id                   String    @id @default(cuid())
  organizationId       String
  studentId            String
  enrollmentId         String
  levelSubjectId       String
  finalGrade           Decimal?  @db.Decimal(5, 2)
  attendancePercentage Decimal?  @db.Decimal(5, 2)
  // StudentSubjectProgressStatus: NOT_STARTED | IN_PROGRESS | PASSED | FAILED | RECOVERY_REQUIRED | INCOMPLETE | BLOCKED
  // (String column — RECOVERY_REQUIRED added by the Recovery Lifecycle needs no migration.)
  status               String    @default("NOT_STARTED")
  progressReason       String?   @db.NVarChar(Max)
  completedAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  enrollment   Enrollment   @relation(fields: [enrollmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  levelSubject LevelSubject @relation(fields: [levelSubjectId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([enrollmentId, levelSubjectId])
  @@index([organizationId, studentId])
  @@index([organizationId, levelSubjectId])
  @@index([organizationId, attendancePercentage], name: "student_subject_progress_org_attendance_idx")
  @@index([organizationId, status], name: "student_subject_progress_org_status_idx")
  @@map("student_subject_progress")
}

model AssessmentRetake {
  id                         String    @id @default(cuid())
  organizationId             String
  originalAssessmentResultId String
  assessmentId               String
  studentId                  String
  enrollmentId               String?
  attemptNumber              Int       @default(1)
  score                      Decimal?  @db.Decimal(5, 2)
  normalizedScore            Decimal?  @db.Decimal(5, 2)
  // AssessmentRetakeStatus: REQUESTED | APPROVED | REJECTED | GRADED
  status                     String    @default("REQUESTED")
  requestedAt                DateTime  @default(now())
  approvedAt                 DateTime?
  approvedByUserId           String?
  gradedAt                   DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  originalResult AssessmentResult @relation(fields: [originalAssessmentResultId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assessment     Assessment       @relation(fields: [assessmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student        Student          @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  enrollment     Enrollment?      @relation(fields: [enrollmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organizationId, studentId])
  @@index([organizationId, assessmentId])
  @@map("assessment_retakes")
}

model StudentAssessmentResult {
  id                    String    @id @default(cuid())
  organizationId        String
  enrollmentId          String
  studentId             String
  levelSubjectId        String
  subjectId             String
  assessmentComponentId String
  assessmentEventId     String?
  // SourceType: CONTINUOUS | SCHEDULED_EVENT | RECOVERY
  sourceType            String    @default("CONTINUOUS")
  grade                 Decimal   @db.Decimal(5, 2)
  maxGrade              Decimal   @db.Decimal(5, 2)
  normalizedGrade       Decimal   @db.Decimal(5, 2)
  notes                 String?   @db.NVarChar(Max)
  // StudentResultStatus: DRAFT | SUBMITTED | GRADED | CANCELLED
  status                String    @default("DRAFT")
  gradedBy              String?
  gradedAt              DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  enrollment          Enrollment          @relation(fields: [enrollmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student             Student             @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  levelSubject        LevelSubject        @relation(fields: [levelSubjectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subject             Subject             @relation(fields: [subjectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assessmentComponent AssessmentComponent @relation(fields: [assessmentComponentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assessmentEvent     Assessment?         @relation(fields: [assessmentEventId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  changeLogs          GradeChangeLog[]

  @@unique([enrollmentId, assessmentComponentId])
  @@index([organizationId, studentId])
  @@index([organizationId, levelSubjectId])
  @@index([organizationId, subjectId])
  @@index([organizationId, enrollmentId])
  @@index([organizationId, enrollmentId, levelSubjectId])
  @@map("student_assessment_results")
}

// =============================================================================
// GRADE CHANGE LOG
// Immutable history of every grade edit after initial submission.
// Created whenever a StudentAssessmentResult grade or status changes.
// =============================================================================

model GradeChangeLog {
  id                        String   @id @default(cuid())
  organizationId            String
  studentAssessmentResultId String
  assessmentEventId         String?
  oldGrade                  Decimal? @db.Decimal(5, 2)
  newGrade                  Decimal  @db.Decimal(5, 2)
  oldNormalizedGrade        Decimal? @db.Decimal(5, 2)
  newNormalizedGrade        Decimal? @db.Decimal(5, 2)
  oldStatus                 String?
  newStatus                 String
  // Origin of the mutation: CREATE | UPDATE | CANCEL | INVALIDATE | RECOVERY | BULK
  source                    String?
  // Reason is required for all post-submission edits
  reason                    String   @db.NVarChar(Max)
  changedBy                 String
  changedAt                 DateTime @default(now())

  organization            Organization            @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  studentAssessmentResult StudentAssessmentResult @relation(fields: [studentAssessmentResultId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organizationId, studentAssessmentResultId])
  @@index([organizationId, changedAt])
  @@map("grade_change_logs")
}

// =============================================================================
// ACADEMIC PREREQUISITES & PROGRESSION
// =============================================================================

model StudentLevelProgress {
  id             String    @id @default(cuid())
  organizationId String
  enrollmentId   String
  studentId      String
  courseId       String
  courseLevelId  String
  finalGrade     Decimal?  @db.Decimal(5, 2)
  earnedCredits  Int?      @default(0)
  // StudentLevelProgressStatus: NOT_STARTED | IN_PROGRESS | PASSED | FAILED | RECOVERY_REQUIRED |
  //   ELIGIBLE_TO_PROGRESS | PROMOTED | PROMOTED_WITH_PENDING_SUBJECTS | BLOCKED | COMPLETED
  status         String    @default("NOT_STARTED")
  progressReason String?   @db.NVarChar(Max)
  completedAt    DateTime?
  calculatedAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  enrollment   Enrollment   @relation(fields: [enrollmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  courseLevel  CourseLevel  @relation(fields: [courseLevelId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([enrollmentId, courseLevelId])
  @@index([organizationId, studentId])
  @@index([organizationId, courseLevelId])
  @@index([organizationId, status], name: "student_level_progress_org_status_idx")
  @@map("student_level_progress")
}

model StudentCourseProgress {
  id             String    @id @default(cuid())
  organizationId String
  enrollmentId   String    @unique
  studentId      String
  courseId       String
  finalGrade     Decimal?  @db.Decimal(5, 2)
  earnedCredits  Int?      @default(0)
  // StudentCourseProgressStatus: NOT_STARTED | IN_PROGRESS | PASSED | FAILED | RECOVERY_REQUIRED | COMPLETED
  status         String    @default("NOT_STARTED")
  progressReason String?   @db.NVarChar(Max)
  completedAt    DateTime?
  calculatedAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  enrollment   Enrollment   @relation(fields: [enrollmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  course       Course       @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organizationId, studentId])
  @@index([organizationId, courseId])
  @@index([organizationId, status], name: "student_course_progress_org_status_idx")
  @@map("student_course_progress")
}

model LevelSubjectPrerequisiteGroup {
  id             String    @id @default(cuid())
  organizationId String
  levelSubjectId String
  name           String?
  description    String?   @db.NVarChar(Max)
  // PrerequisiteGroupLogicType: ALL | ANY
  logicType      String    @default("ALL")
  // PrerequisiteGroupStatus: ACTIVE | INACTIVE | ARCHIVED
  status         String    @default("ACTIVE")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization                   @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  levelSubject LevelSubject                   @relation(fields: [levelSubjectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  items        LevelSubjectPrerequisiteItem[]
  waivers      PrerequisiteWaiver[]

  @@index([organizationId, levelSubjectId, status])
  @@map("level_subject_prerequisite_groups")
}

model LevelSubjectPrerequisiteItem {
  id                         String    @id @default(cuid())
  organizationId             String
  prerequisiteGroupId        String
  prerequisiteLevelSubjectId String
  // PrerequisiteRequirementType: MUST_PASS | MUST_COMPLETE | MINIMUM_GRADE
  requirementType            String    @default("MUST_PASS")
  minimumRequiredGrade       Decimal?  @db.Decimal(5, 2)
  // PrerequisiteItemStatus: ACTIVE | INACTIVE | ARCHIVED
  status                     String    @default("ACTIVE")
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
  deletedAt                  DateTime?

  organization             Organization                  @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  prerequisiteGroup        LevelSubjectPrerequisiteGroup @relation(fields: [prerequisiteGroupId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  prerequisiteLevelSubject LevelSubject                  @relation("PrerequisiteSubject", fields: [prerequisiteLevelSubjectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  waivers                  PrerequisiteWaiver[]

  @@index([organizationId, prerequisiteGroupId])
  @@index([organizationId, prerequisiteLevelSubjectId])
  @@map("level_subject_prerequisite_items")
}

model PrerequisiteWaiver {
  id                  String    @id @default(cuid())
  organizationId      String
  studentId           String
  enrollmentId        String
  levelSubjectId      String
  prerequisiteGroupId String?
  prerequisiteItemId  String?
  reason              String    @db.NVarChar(Max)
  grantedBy           String
  grantedAt           DateTime  @default(now())
  // PrerequisiteWaiverStatus: ACTIVE | REVOKED
  status              String    @default("ACTIVE")
  revokedBy           String?
  revokedAt           DateTime?
  revokedReason       String?   @db.NVarChar(Max)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  organization      Organization                   @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student           Student                        @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  enrollment        Enrollment                     @relation(fields: [enrollmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  levelSubject      LevelSubject                   @relation(fields: [levelSubjectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  prerequisiteGroup LevelSubjectPrerequisiteGroup? @relation(fields: [prerequisiteGroupId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  prerequisiteItem  LevelSubjectPrerequisiteItem?  @relation(fields: [prerequisiteItemId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organizationId, studentId])
  @@index([organizationId, enrollmentId, levelSubjectId])
  @@map("prerequisite_waivers")
}

model LevelProgressionPolicy {
  id                        String    @id @default(cuid())
  organizationId            String
  courseId                  String
  fromLevelId               String
  toLevelId                 String
  name                      String
  description               String?   @db.NVarChar(Max)
  // ProgressionMode: STRICT | CONDITIONAL | CREDIT_BASED | MANUAL_APPROVAL
  progressionMode           String    @default("STRICT")
  minimumLevelAverage       Decimal?  @db.Decimal(5, 2)
  maxFailedRequiredSubjects Int?      @default(0)
  maxPendingSubjects        Int?      @default(0)
  requiredCredits           Int?
  requireFinancialClearance Boolean   @default(false)
  requireManualApproval     Boolean   @default(false)
  // LevelProgressionPolicyStatus: ACTIVE | INACTIVE | ARCHIVED
  status                    String    @default("ACTIVE")
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  deletedAt                 DateTime?

  organization        Organization              @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  course              Course                    @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fromLevel           CourseLevel               @relation("FromLevel", fields: [fromLevelId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  toLevel             CourseLevel               @relation("ToLevel", fields: [toLevelId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  progressionRequests LevelProgressionRequest[]

  @@unique([courseId, fromLevelId, toLevelId])
  @@index([organizationId, courseId, status])
  @@map("level_progression_policies")
}

model LevelProgressionRequest {
  id             String    @id @default(cuid())
  organizationId String
  enrollmentId   String
  studentId      String
  courseId       String
  policyId       String?
  fromLevelId    String
  toLevelId      String
  // ProgressionRequestDecision: PENDING | APPROVED | REJECTED
  decision       String    @default("PENDING")
  reason         String?   @db.NVarChar(Max)
  reviewNotes    String?   @db.NVarChar(Max)
  requestedAt    DateTime  @default(now())
  reviewedAt     DateTime?
  reviewedBy     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  enrollment   Enrollment              @relation(fields: [enrollmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student      Student                 @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  course       Course                  @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  policy       LevelProgressionPolicy? @relation(fields: [policyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fromLevel    CourseLevel             @relation("FromLevelRequests", fields: [fromLevelId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  toLevel      CourseLevel             @relation("ToLevelRequests", fields: [toLevelId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organizationId, enrollmentId])
  @@index([organizationId, studentId])
  @@index([organizationId, decision])
  @@map("level_progression_requests")
}

// =============================================================================
// REFUNDS
// =============================================================================

model Refund {
  id              String    @id @default(cuid())
  organizationId  String
  branchId        String?
  paymentId       String
  receiptId       String?
  studentId       String?
  enrollmentId    String?
  invoiceId       String?
  refundNumber    String
  amount          Decimal   @db.Decimal(10, 2)
  reason          String    @db.NVarChar(Max)
  // RefundStatus: REQUESTED | APPROVED | REJECTED | COMPLETED
  status          String    @default("REQUESTED")
  // RefundMethod: CASH_RETURN | WALLET_CREDIT
  refundMethod    String    @default("CASH_RETURN")
  notes           String?   @db.NVarChar(Max)
  rejectionReason String?   @db.NVarChar(Max)
  requestedBy     String
  approvedBy      String?
  rejectedBy      String?
  completedBy     String?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payment      Payment      @relation(fields: [paymentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  receipt      Receipt?     @relation(fields: [receiptId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student      Student?     @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  enrollment   Enrollment?  @relation(fields: [enrollmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  invoice      Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([organizationId, refundNumber])
  @@index([organizationId, status, createdAt], name: "refunds_org_status_createdat_idx")
  @@index([organizationId, paymentId, status], name: "refunds_org_payment_status_idx")
  @@index([organizationId, createdAt], name: "refunds_org_createdat_idx")
  @@index([organizationId, status, completedAt], name: "refunds_org_status_completedat_idx")
  @@map("refunds")
}

// =============================================================================
// FINANCIAL TRANSACTION LEDGER (append-only)
// =============================================================================
// CRITICAL: This model is IMMUTABLE. Never update or delete rows.
// Every financial movement produces one or more journal entries here.
// Used as the source of truth for reconciliation and cash-flow reports.

model FinancialTransaction {
  id                String   @id @default(cuid())
  organizationId    String
  transactionNumber String
  // FinancialTransactionType:
  //   INVOICE_CREATED | INVOICE_CANCELLED |
  //   PAYMENT_RECEIVED | PAYMENT_CANCELLED |
  //   CREDIT_APPLIED |
  //   WALLET_CREDIT | WALLET_DEBIT |
  //   REFUND_DISBURSED | RECEIPT_ISSUED
  transactionType   String
  // FinancialDirection: CREDIT | DEBIT  (from organization's perspective)
  direction         String
  amount            Decimal  @db.Decimal(10, 2)
  currencyCode      String   @default("MZN")
  // sourceType: "Invoice" | "Payment" | "Receipt" | "Refund" |
  //             "WalletTransaction" | "CreditApplication"
  sourceType        String
  sourceId          String
  // Cross-references for reconciliation queries
  invoiceId         String?
  paymentId         String?
  receiptId         String?
  refundId          String?
  studentId         String?
  enrollmentId      String?
  description       String?  @db.NVarChar(Max)
  actorId           String?
  occurredAt        DateTime @default(now())
  createdAt         DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([organizationId, transactionNumber])
  @@index([organizationId, invoiceId])
  @@index([organizationId, paymentId])
  @@index([organizationId, studentId])
  @@index([organizationId, occurredAt])
  @@index([organizationId, transactionType])
  @@index([organizationId, transactionType, occurredAt], name: "financial_tx_org_type_occurredat_idx")
  @@index([organizationId, sourceType, sourceId], name: "financial_tx_org_source_ref_idx")
  @@index([organizationId, studentId, occurredAt], name: "financial_tx_org_student_occurredat_idx")
  @@map("financial_transactions")
}

// =============================================================================
// FINANCIAL INTEGRITY ISSUES
// =============================================================================
// Populated by the daily integrity-check job. Never auto-repaired — only
// detected and recorded. Resolved by a human operator via the admin UI.

model FinancialIntegrityIssue {
  id              String    @id @default(cuid())
  organizationId  String
  // IntegrityIssueSeverity: CRITICAL | HIGH | MEDIUM | LOW
  severity        String
  // IntegrityIssueCategory: INVOICE_BALANCE | INSTALLMENT_BALANCE |
  //   PAYMENT_ALLOCATION | WALLET_BALANCE | REFUND_TOTAL |
  //   RECEIPT_INTEGRITY | ORPHAN_RECORD | LEDGER_CONSISTENCY
  category        String
  // Machine-readable check identifier e.g. "invoice.balance_amounts"
  checkName       String
  // Domain entity type e.g. "Invoice", "Payment", "Receipt", "Refund"
  entityType      String
  entityId        String
  description     String    @db.NVarChar(Max)
  expectedValue   String?
  actualValue     String?
  detectedAt      DateTime  @default(now())
  jobRunId        String?
  // IntegrityIssueStatus: OPEN | ACKNOWLEDGED | RESOLVED | SUPPRESSED
  status          String    @default("OPEN")
  resolvedAt      DateTime?
  resolvedBy      String?
  resolutionNotes String?   @db.NVarChar(Max)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // No @@unique here: deduplication of OPEN issues is enforced by the
  // filtered unique index in migration SQL (WHERE status = 'OPEN').
  @@index([organizationId, severity])
  @@index([organizationId, category])
  @@index([organizationId, status, detectedAt])
  @@index([organizationId, entityType, entityId])
  @@index([organizationId, status, severity], name: "fii_org_status_severity_idx")
  @@index([organizationId, category, status], name: "fii_org_category_status_idx")
  @@map("financial_integrity_issues")
}

// =============================================================================
// FINANCIAL AUDIT LOG
// =============================================================================

model FinancialAuditLog {
  id             String   @id @default(cuid())
  organizationId String
  eventType      String
  entityType     String
  entityId       String
  performedBy    String?
  performedAt    DateTime @default(now())
  amount         Decimal? @db.Decimal(18, 2)
  currency       String   @default("MZN")
  beforeData     String?  @db.NVarChar(Max)
  afterData      String?  @db.NVarChar(Max)
  metadata       String?  @db.NVarChar(Max)
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organizationId, entityType, entityId])
  @@index([organizationId, eventType])
  @@index([organizationId, performedAt])
  @@index([organizationId, performedBy])
  @@map("financial_audit_logs")
}

// =============================================================================
// STUDENT DOCUMENTS
// =============================================================================

model StudentDocument {
  id             String    @id @default(cuid())
  organizationId String
  studentId      String
  // StudentDocumentType: IDENTIFICATION | PASSPORT | CERTIFICATE | CONTRACT | PAYMENT_PROOF | PHOTO | OTHER
  documentType   String
  fileName       String
  fileUrl        String    @db.NVarChar(Max)
  fileSize       Int?
  // StudentDocumentStatus: PENDING | VERIFIED | REJECTED
  status         String    @default("PENDING")
  notes          String?   @db.NVarChar(Max)
  uploadedBy     String?
  verifiedBy     String?
  verifiedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organizationId, studentId])
  @@map("student_documents")
}

// =============================================================================
// ACADEMIC TRANSCRIPT ENGINE
// =============================================================================

// Per-(organization, year, transcriptType) sequence counter for human-facing
// transcript numbers (TRN-{year}-{seq}). The number is allocated at ISSUE time
// (per D9); counter rows are never deleted, so revoked/superseded transcripts
// still consume their sequence value.
model TranscriptNumberCounter {
  id             String   @id @default(cuid())
  organizationId String
  year           Int
  transcriptType String
  lastSeq        Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([organizationId, year, transcriptType])
  @@map("transcript_number_counters")
}
