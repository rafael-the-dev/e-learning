model AttendanceSession {
  id              String    @id @default(cuid())
  organizationId  String
  branchId        String?
  academicYearId  String
  academicTermId  String?
  classGroupId    String
  courseId        String
  courseLevelId   String
  subjectId       String
  levelSubjectId  String
  teacherId       String?
  classroomId     String?
  scheduleSlotId  String?
  sessionDate     DateTime
  startTime       String
  endTime         String
  durationMinutes Int
  title           String?
  notes           String?   @db.NVarChar(Max)
  // AttendanceSessionStatus: DRAFT | OPEN | COMPLETED | CANCELLED | ARCHIVED
  status          String    @default("DRAFT")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  createdBy       String?

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branch       Branch?            @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  academicYear AcademicYear       @relation(fields: [academicYearId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  academicTerm AcademicTerm?      @relation(fields: [academicTermId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  classGroup   ClassGroup         @relation(fields: [classGroupId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subject      Subject            @relation(fields: [subjectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  teacher      Teacher?           @relation(fields: [teacherId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  classroom    Classroom?         @relation(fields: [classroomId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  scheduleSlot ScheduleSlot?      @relation(fields: [scheduleSlotId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  records      AttendanceRecord[]

  @@index([organizationId, classGroupId, sessionDate])
  @@index([organizationId, status])
  @@index([organizationId, status, sessionDate], name: "attendance_sessions_org_status_sessiondate_idx")
  @@map("attendance_sessions")
}

model AttendanceRecord {
  id                  String    @id @default(cuid())
  organizationId      String
  attendanceSessionId String
  studentId           String
  // Phase 1: kept NULLABLE deliberately — existing rows may lack an enrolment.
  // Phase 2 backfills (student, classGroup, session date) → enrolment and then
  // promotes this to NOT NULL. See docs/attendance-engine.md.
  enrollmentId        String?
  // AttendanceRecordStatus: PRESENT | ABSENT | LATE | EXCUSED | REMOTE
  status              String    @default("ABSENT")
  checkInAt           DateTime?
  checkOutAt          DateTime?
  minutesAttended     Int       @default(0)
  lateMinutes         Int?
  markedByUserId      String?
  markedAt            DateTime?
  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  organization      Organization              @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  attendanceSession AttendanceSession         @relation(fields: [attendanceSessionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student           Student                   @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  justifications    AttendanceJustification[]

  @@unique([attendanceSessionId, studentId])
  @@index([organizationId, studentId])
  @@index([organizationId, enrollmentId])
  @@map("attendance_records")
}

model AttendanceJustification {
  id                 String    @id @default(cuid())
  organizationId     String
  attendanceRecordId String
  studentId          String
  reason             String    @db.NVarChar(Max)
  attachmentUrl      String?
  // AttendanceJustificationStatus: PENDING | APPROVED | REJECTED
  status             String    @default("PENDING")
  reviewedByUserId   String?
  reviewedAt         DateTime?
  reviewNotes        String?   @db.NVarChar(Max)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  attendanceRecord AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student          Student          @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organizationId, studentId])
  @@index([organizationId, status])
  @@map("attendance_justifications")
}

// =============================================================================
// ATTENDANCE ENGINE — PHASE 1 (schema foundation only)
// AttendancePolicy governs *interpretation* of attendance only. It NEVER stores
// thresholds — minimumAttendancePercentage / maxAbsences stay on LevelSubject
// (Decision #1). The two summary models are persisted read-models: nothing
// writes them yet (Phase 4) and they do NOT drive academic progression yet
// (Phase 5, gated). See docs/attendance-engine-domain.md + docs/attendance-engine.md.
// =============================================================================

model AttendancePolicy {
  id                           String    @id @default(cuid())
  organizationId               String
  name                         String
  // Interpretation knobs only (never thresholds).
  countExcusedAsPresent        Boolean   @default(false)
  countRemoteAsPresent         Boolean   @default(true)
  countLateAsPartial           Boolean   @default(true)
  lateAfterMinutes             Int       @default(10)
  absenceAfterMinutes          Int       @default(30)
  atRiskBufferPercentage       Decimal   @default(5) @db.Decimal(5, 2)
  // Justification workflow.
  allowJustification           Boolean   @default(true)
  requireJustificationApproval Boolean   @default(true)
  justificationWindowDays      Int?
  // Session lifecycle.
  autoCloseSessions            Boolean   @default(false)
  // Attendance Engine Phase 5 — GATED academic wiring. When true, this policy's
  // subjects feed StudentSubjectAttendanceSummary.attendancePercentage into the
  // grade cascade and low attendance can produce INCOMPLETE. Default false →
  // attendance stays reporting-only (behaviour-neutral). The THRESHOLD still
  // lives on LevelSubject.minimumAttendancePercentage; this only enables enforcement.
  enforceAttendanceForProgress Boolean   @default(false)
  isDefault                    Boolean   @default(false)
  // AttendancePolicyStatus: ACTIVE | INACTIVE | ARCHIVED
  status                       String    @default("ACTIVE")
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt
  deletedAt                    DateTime?

  organization               Organization                      @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  levelSubjects              LevelSubject[]
  subjectAttendanceSummaries StudentSubjectAttendanceSummary[]

  // "One default active policy per organization" is enforced by a FILTERED
  // unique index (WHERE isDefault = 1 AND deletedAt IS NULL) created in the
  // migration — Prisma @@unique cannot express the predicate.
  @@index([organizationId, status])
  @@map("attendance_policies")
}

model StudentSubjectAttendanceSummary {
  id                    String    @id @default(cuid())
  organizationId        String
  enrollmentId          String
  studentId             String
  levelSubjectId        String
  // Policy in effect for this summary (interpretation snapshot). Optional:
  // falls back to the org default when null.
  attendancePolicyId    String?
  totalSessions         Int       @default(0)
  totalScheduledMinutes Int       @default(0)
  totalPresentMinutes   Int       @default(0)
  totalAbsentMinutes    Int       @default(0)
  totalLateMinutes      Int       @default(0)
  totalExcusedMinutes   Int       @default(0)
  attendancePercentage  Decimal?  @db.Decimal(5, 2)
  // StudentSubjectAttendanceSummaryStatus: NOT_STARTED | SUFFICIENT | AT_RISK | BELOW_REQUIRED
  status                String    @default("NOT_STARTED")
  // Null until the first recalculation writes it (Phase 4).
  calculatedAt          DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  enrollment       Enrollment        @relation(fields: [enrollmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student          Student           @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  levelSubject     LevelSubject      @relation(fields: [levelSubjectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  attendancePolicy AttendancePolicy? @relation(fields: [attendancePolicyId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([enrollmentId, levelSubjectId])
  @@index([organizationId, studentId])
  @@index([organizationId, levelSubjectId])
  @@index([organizationId, status])
  @@index([organizationId, calculatedAt])
  @@map("student_subject_attendance_summaries")
}

model StudentPeriodAttendanceSummary {
  id                    String    @id @default(cuid())
  organizationId        String
  academicYearId        String
  academicTermId        String?
  enrollmentId          String
  studentId             String
  courseId              String
  courseLevelId         String?
  classGroupId          String?
  totalSessions         Int       @default(0)
  presentCount          Int       @default(0)
  absentCount           Int       @default(0)
  lateCount             Int       @default(0)
  excusedCount          Int       @default(0)
  remoteCount           Int       @default(0)
  totalScheduledMinutes Int       @default(0)
  totalPresentMinutes   Int       @default(0)
  attendancePercentage  Decimal?  @db.Decimal(5, 2)
  // StudentPeriodAttendanceSummaryStatus: GOOD | AT_RISK | BELOW_REQUIRED
  status                String    @default("GOOD")
  // Null until the first recalculation writes it (Phase 6).
  calculatedAt          DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  academicYear AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  academicTerm AcademicTerm? @relation(fields: [academicTermId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  enrollment   Enrollment    @relation(fields: [enrollmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student      Student       @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  course       Course        @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  courseLevel  CourseLevel?  @relation(fields: [courseLevelId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  classGroup   ClassGroup?   @relation(fields: [classGroupId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // Uniqueness of (enrollmentId, academicYearId, academicTermId) with a NULLABLE
  // academicTermId is enforced by TWO filtered unique indexes in the migration
  // (SQL Server treats multiple NULLs as duplicates under a plain UNIQUE).
  @@index([organizationId, studentId])
  @@index([organizationId, academicYearId])
  @@index([organizationId, academicTermId])
  @@index([organizationId, classGroupId])
  @@index([organizationId, status])
  @@index([organizationId, calculatedAt])
  @@map("student_period_attendance_summaries")
}

